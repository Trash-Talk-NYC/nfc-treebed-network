---
// The block admin page (design-record.md, constraint 10; approved-screens
// section 1): the typed reference address, one row per bed down the street,
// and the opened bed's controls — the bed profile (the guard and the three
// facts as three-way radios with their own NOT RECORDED choice, plus the three
// typed notes), per-slot adoption switches, add-slot, the bed-name takedown,
// the steward click-through — behind one SAVE CHANGES, with the bed's open
// report stated read-only beside them.
//
// One markup serves both approved layouts. Above 860px it is the two-pane
// desk page; below, it is the phone flow — the list, or the opened bed over
// it — switched by the `mode-*` class from the URL's own `?bed=` / `?steward=`
// params, so every state is a link and the whole page works with no script.
// The one enhancement is the honest unsaved-changes line, which only ever
// CLAIMS dirt when a script has watched it happen; without the script the
// line states what the server last knew.
import AdminScreen from '../../../../layouts/AdminScreen.astro';
import AdminPhotoGrid from '../../../../components/AdminPhotoGrid.astro';
import { refuseAdminWithBody, requireAdmin } from '../../../../lib/admin-route';
import { bi } from '../../../../lib/bilingual';
import { ADMIN, ADOPT, COMMON } from '../../../../lib/copy';
import {
  bedHeadingName,
  bedRowName,
  confirmationsLabel,
  openedLabel,
  sinceLabel,
  slotsFilledLabel,
} from '../../../../lib/format';
import { langLink, resolveLang, type Lang, type Phrase } from '../../../../lib/i18n';
import { defaultPresentation, presentationFor } from '../../../../lib/presentation';
import { MAX_NOTE_CHARS, problemFor } from '../../../../lib/problem';
import { MAX_FORM_BYTES, readFormOrRefuse } from '../../../../lib/request-body';
import { capped } from '../../../../lib/typed-text';
import {
  ADMIN_EARLIER_PHOTOS_SHOWN,
  MAX_ADDRESS_CHARS,
  MAX_BED_NOTE_CHARS,
  MAX_BED_SLOTS,
  MAX_TREE_TYPE_CHARS,
  RuleError,
  getBlockView,
  saveBlockSettings,
  type AdminBedView,
} from '../../../../lib/service';
import { getStore } from '../../../../lib/store';
import {
  GUARD_MATERIALS,
  UNRECORDED_CHOICE,
  bedFactFrom,
  guardMaterialFrom,
  publicHandle,
  publicInitials,
  type GuardMaterial,
  type Report,
} from '../../../../lib/types';

const lang: Lang = resolveLang(Astro.url, Astro.cookies);
const gate = await requireAdmin(Astro.request, Astro.cookies, langLink('/admin', lang));
if (gate.refused) return gate.refused;

const store = getStore();
const blockId = Astro.params.block ?? '';

// A refused save — and a "+ ADD SLOT" press, which writes nothing — re-render
// this page rather than redirecting, so the switches come back exactly as they
// were left: the point of refusing is that nothing silently becomes a
// different selection, and the point of the press is that nothing is committed
// until SAVE CHANGES.
let slotError: Phrase | null = null;
// The open bed was deleted elsewhere while this tab held it: nothing saved.
let staleBed = false;
let submitted: {
  address: string;
  treeType: { en: string; es: string } | undefined;
  guard: GuardMaterial | null | undefined;
  treePresent: boolean | null | undefined;
  plantsPresent: boolean | null | undefined;
  plantingRecommended: boolean | null | undefined;
  plantsNote: string | undefined;
  recommendedPlantsNote: string | undefined;
  careNote: string | undefined;
  slots: Set<number>;
  addSlots: number;
  clearName: boolean;
} | null = null;

if (Astro.request.method === 'POST') {
  // Behind the session, but read under the same bounds as every public POST:
  // a cookie is not a licence for an unbounded body (request-body.ts).
  const { form, refused } = await readFormOrRefuse(Astro.request, MAX_FORM_BYTES, 'admin save');
  if (refused) return refused;
  const plate = String(form.get('plate') ?? '');
  const referenceAddress = String(form.get('referenceAddress') ?? '');
  // A radio always submits, because the panel draws NOT RECORDED as a fourth
  // choice and checks it while nobody has recorded the guard: null is that
  // choice — the captain taking a fact back — and undefined is a form that
  // carried no radio at all, which keeps the guard as it stands.
  const guard = guardMaterialFrom(form.get('guard'));
  // The species, as two typed fields — a name, not a yes/no, so it is not a
  // radio group like the facts below. The same keep-as-it-stands rule holds:
  // a form that carried neither field keeps the species exactly as it is, and
  // only a form that carried the English one — blank, deliberately cleared —
  // takes it back to NOT YET RECORDED (`resolveSpecies`).
  const treeType =
    form.has('tree-type-en') || form.has('tree-type-es')
      ? {
          en: String(form.get('tree-type-en') ?? ''),
          es: String(form.get('tree-type-es') ?? ''),
        }
      : undefined;
  // The profile's three three-way facts, read exactly like the guard above:
  // null is the NOT RECORDED choice and undefined is a form with no radio.
  // The tree is a radio group rather than a switch for that reason — an
  // unchecked checkbox and a field that never arrived are the same bytes, so
  // a stale page or a hand-built POST would publish "no tree" for a bed
  // nobody has looked at.
  const treePresent = bedFactFrom(form.get('tree-present'));
  const plantsPresent = bedFactFrom(form.get('plants-present'));
  const plantingRecommended = bedFactFrom(form.get('planting-recommended'));
  // Same rule for the typed notes: a field the form did not carry keeps what
  // stands, so nothing on the profile is blanked by a partial POST.
  const notedFrom = (field: string): string | undefined =>
    form.has(field) ? String(form.get(field) ?? '') : undefined;
  const plantsNote = notedFrom('plants-note');
  const recommendedPlantsNote = notedFrom('recommended-plants-note');
  const careNote = notedFrom('care-note');
  // The bed-name removal switch (service.ts, `BlockSaveInput`): committed by
  // SAVE CHANGES like every other panel control, never on its own press.
  const clearBedName = form.get('clear-bed-name') !== null;
  // The slot NUMBERS, not how many of them there are: `offeredSlots` is a
  // count covering slots 1..n, so a gapped selection has no representation
  // and saving its size would flip a different switch than the captain did.
  const offeredSlotNumbers = form.getAll('slot-open').map((value) => Number(value));
  // How many slots the page in front of the captain had drawn past the bed's
  // stored count, carried in one hidden field so a press accumulates rather
  // than replacing what an earlier one added.
  const carriedSlots = form
    .getAll('add-slot')
    .reduce((total, value) => total + (Number.isFinite(Number(value)) ? Number(value) : 0), 0);
  // "+ ADD SLOT" is page-local: it draws one more switch and writes NOTHING.
  // SAVE CHANGES is the single commit point the panel already claims to have,
  // so a mis-tap costs a re-render rather than growing the bed for good — a
  // slot cannot be taken back once it is stored. No script is involved: the
  // press is a plain submit and the answer is the panel, redrawn.
  const addSlots = form.get('intent') === 'add-slot' ? carriedSlots + 1 : carriedSlots;
  const asSubmitted = (): NonNullable<typeof submitted> => ({
    address: referenceAddress,
    treeType,
    guard,
    treePresent,
    plantsPresent,
    plantingRecommended,
    plantsNote,
    recommendedPlantsNote,
    careNote,
    slots: new Set(offeredSlotNumbers.filter(Number.isFinite)),
    addSlots,
    clearName: clearBedName,
  });
  if (form.get('intent') === 'add-slot') {
    submitted = asSubmitted();
  } else {
    try {
      await saveBlockSettings(store, {
        blockId,
        referenceAddress,
        bed:
          plate === ''
            ? undefined
            : {
                plate,
                treeType,
                guard,
                treePresent,
                plantsPresent,
                plantingRecommended,
                plantsNote,
                recommendedPlantsNote,
                careNote,
                offeredSlotNumbers,
                addSlots,
                clearBedName,
              },
      });
    } catch (err) {
      if (err instanceof RuleError && err.code === 'block-not-found') {
        return new Response('Not found.', { status: 404 });
      }
      if (err instanceof RuleError && err.code === 'bed-not-found') {
        // The open bed was deleted between this page rendering and the press —
        // another tab, or the phone in the captain's other hand. The block is
        // fine, so the answer is the block page the bed has gone from. It is
        // RE-RENDERED rather than redirected to, because the save wrote
        // nothing at all (`saveBlockSettings` finds every refusal before its
        // first write) and a redirect would drop the address the captain had
        // just retyped. It comes back in the field, and the flash says both
        // things: the bed is gone, and nothing was saved. A real missing
        // block keeps its plain 404 above.
        staleBed = true;
        submitted = asSubmitted();
        Astro.response.status = 409;
      } else if (
        err instanceof RuleError &&
        (err.code === 'invalid-input' || err.code === 'slot-out-of-range')
      ) {
        // Two refusals, two explanations: a gap in the switches is something
        // to reorder, a slot number this bed does not have is a page that has
        // gone stale — telling the captain to reorder switches already in
        // order explains nothing.
        slotError =
          err.code === 'slot-out-of-range' ? ADMIN.slotOutOfRange : ADMIN.slotsNotContiguous;
        submitted = asSubmitted();
        Astro.response.status = 422;
      } else {
        throw err;
      }
    }
  }
  if (submitted === null) {
    const params = new URLSearchParams();
    if (plate !== '') params.set('bed', plate);
    params.set('saved', '1');
    // The form's action carries the whole query string through, so a save made
    // with the older photos revealed comes back revealed: collapsing to the
    // capped six would cost a tap on a phone on the sidewalk.
    if (Astro.url.searchParams.get('photos') === 'all') params.set('photos', 'all');
    return Astro.redirect(langLink(`/admin/blocks/${blockId}?${params}`, lang), 303);
  }
}

const view = await getBlockView(store, blockId, Astro.url.searchParams.get('bed'));
if (!view) {
  return await refuseAdminWithBody(Astro.request, new Response('Not found.', { status: 404 }));
}
const { block, beds, retired } = view;

const selected = beds.find((b) => b.bed.plate === Astro.url.searchParams.get('bed')) ?? null;
const steward =
  selected?.stewards.find((s) => s.user.id === Astro.url.searchParams.get('steward')) ?? null;
const savedFlash = Astro.url.searchParams.get('saved') === '1';
// The delete confirmation (`delete-bed.astro`) lands back here with this flag:
// the bed is gone from the list, and the page says so rather than leaving the
// captain to count beds.
const deletedFlash = Astro.url.searchParams.get('deleted') === '1';
// And the way back from one: the bed is on the list again, with its tag live.
const restoredFlash = Astro.url.searchParams.get('restored') === '1';
// The photo delete confirmation (`delete-photo.astro`) lands back here with
// this flag, on the bed panel it left from.
const photoDeletedFlash = Astro.url.searchParams.get('photodeleted') === '1';
// A panel link to a bed that has since been deleted — a bookmark, history, or
// the language toggle carrying the stale `bed=` along — lands in list mode,
// and says the bed is gone rather than nothing, the way `add-steward.astro`
// already answers the same stale plate.
const retiredParam =
  selected === null && retired.some((b) => b.plate === Astro.url.searchParams.get('bed'));
const mode = selected ? 'panel' : 'list';
// Whether the stale save carried an address the store does not have — judged
// the way `saveBlockSettings` judges it (trimmed, and an empty field writes
// nothing), so the page only claims something is left to keep when a SAVE
// ADDRESS would in fact write it.
const addressChanged =
  submitted !== null &&
  submitted.address.trim() !== '' &&
  submitted.address.trim() !== block.referenceAddress;
// The stale re-render is dirty only by the address: the switches it carried
// belonged to a bed that no longer exists, so with the address as stored
// there is nothing on the page to guard.
const dirty = submitted !== null && (!staleBed || addressChanged);
const flash: Phrase | null = staleBed
  ? addressChanged
    ? ADMIN.bedDeletedElsewhereKeepAddress
    : ADMIN.bedDeletedElsewhere
  : deletedFlash || retiredParam
    ? ADMIN.bedDeleted
    : restoredFlash
      ? ADMIN.bedRestored
      : photoDeletedFlash
        ? ADMIN.photoDeleted
        : null;
// The slot count the panel draws. A "+ ADD SLOT" press — and a refused save
// that had made one — comes back with that slot on the page, and a hidden
// field carries it into the next submit, so nothing but SAVE CHANGES grows
// the bed and the switch flipped on it still has somewhere to be.
const panelSlots = selected
  ? Math.min(MAX_BED_SLOTS, selected.bed.slots + (submitted?.addSlots ?? 0))
  : 0;

const presentation = selected
  ? presentationFor(selected.bed)
  : beds[0]
    ? presentationFor(beds[0].bed)
    : defaultPresentation();

const base = `/admin/blocks/${blockId}`;
const bedLink = (plate: string): string => langLink(`${base}?bed=${plate}`, lang);

/** The bed list's small line, and the panel's three radio segments. */
const GUARD_LABEL: Record<GuardMaterial, Phrase> = {
  none: ADMIN.guardNone,
  wood: ADMIN.guardWood,
  metal: ADMIN.guardMetal,
};
/** The list line for a guard nobody has recorded yet — distinct from "no guard". */
const guardLabel = (guard: GuardMaterial | null): Phrase =>
  guard === null ? ADMIN.guardUnset : GUARD_LABEL[guard];
const GUARD_OPTION: Record<GuardMaterial, Phrase> = {
  none: ADMIN.guardOptNone,
  wood: ADMIN.guardOptWood,
  metal: ADMIN.guardOptMetal,
};

/** At a glance (spec): adopted — and HOW — versus open versus not offered. */
function bedState(b: AdminBedView): { dot: string; badge: Phrase; badgeClass: string } {
  if (b.stewards.length > 0) {
    const paper = b.stewards.some(({ adoption }) => adoption.stewardKind === 'pen-and-paper');
    return {
      dot: 'dot-adopted',
      badge: paper ? ADMIN.badgePaper : ADMIN.badgeNfc,
      badgeClass: paper ? 'badge-paper' : 'badge-nfc',
    };
  }
  if (b.bed.offeredSlots > 0)
    return { dot: 'dot-open', badge: ADMIN.badgeOpen, badgeClass: 'b-open' };
  return { dot: 'dot-closed', badge: ADMIN.badgeClosed, badgeClass: 'b-closed' };
}

/**
 * The opened bed's open report as the panel states it — read-only, sourced
 * from the same record the steward's view reads (`AdminBedView.openReport`).
 * The admin sees it here; closing it is the steward's act on their own view.
 */
const openReportLines = (report: Report, confirms: AdminBedView['openReportConfirms']) => ({
  problems: report.categories.map(problemFor),
  opened: openedLabel(new Date(report.openedAt)),
  confirmations: confirmationsLabel(report.confirmedBy.length),
  // Sanitised HERE as well as at the write, because this band is a new
  // surface for notes the live store already holds: the pilot's own open
  // report was written before `capped` reached the visitor's note, and a
  // stored U+202E would scramble the admin copy it sits beside.
  note: capped(report.note, MAX_NOTE_CHARS),
  photo: report.photoAttached,
  // What the neighbours who added their weight said — the same categories and
  // sentences the steward reads on `mine.astro`, so the captain's surface is
  // not the one that sees less of a report the public FAQ says we see.
  alsoSaid: confirms.map(({ categories, note }) => ({
    problems: categories.map(problemFor),
    note: capped(note, MAX_NOTE_CHARS),
  })),
});
const openReport = selected?.openReport
  ? openReportLines(selected.openReport, selected.openReportConfirms)
  : null;

// The opened bed's stored photos, split by the exact report join — never a
// time window: the open report's own sit under its band, and the rest are the
// bed's history from reports since closed. Each is a link to the delete
// confirmation (`delete-photo.astro`), a LINK for the same two reasons the
// retired rows' RESTORE is one: the panel sits inside the page's single big
// form, and a destructive act gets its own deliberate second tap.
const openReportPhotos = (selected?.photos ?? []).filter(
  (p) => selected?.openReport !== null && p.reportId === selected?.openReport?.id,
);
const allEarlierPhotos = (selected?.photos ?? []).filter(
  (p) => selected?.openReport === null || p.reportId !== selected?.openReport?.id,
);
// Capped at the most recent few unless the captain asked for the rest: the
// history has no pruning behind it, and every photo drawn is a full download
// through the function. The reveal is a query param the server reads, so it
// works with no script like every other state on this page.
const showAllPhotos = Astro.url.searchParams.get('photos') === 'all';
const earlierPhotos = showAllPhotos
  ? allEarlierPhotos
  : allEarlierPhotos.slice(0, ADMIN_EARLIER_PHOTOS_SHOWN);
const olderPhotosHidden = allEarlierPhotos.length - earlierPhotos.length;

// What the panel's three-way rows stand at right now: the pick a refused save
// left on the page, otherwise the record. The badge, the sub-line and the
// radios all read this one value, so the panel never says NOT SET beside a
// radio the captain has just checked.
// A submit that carried no radio at all (undefined) changed nothing, so the
// panel redraws the record rather than inventing a NOT SET the save did not
// make.
// The species fields, same rule: what a refused save left typed, otherwise
// what is stored. A stored species is shown as stored — the casing the
// species table or the typist gave it, the way the door frame reads it
// (`capitalizeFirst` is a render-site act elsewhere, never a rewrite of the
// value) — so what the captain edits is the record.
const panelSpecies = submitted?.treeType ?? {
  en: selected?.bed.treeType?.en ?? '',
  es: selected?.bed.treeType?.es ?? '',
};
const speciesUnset = panelSpecies.en.trim() === '';
const panelGuard =
  submitted?.guard !== undefined ? (submitted?.guard ?? null) : (selected?.bed.guard ?? null);
const panelTree =
  submitted?.treePresent !== undefined
    ? (submitted?.treePresent ?? null)
    : (selected?.bed.treePresent ?? null);
const panelPlants =
  submitted?.plantsPresent !== undefined
    ? (submitted?.plantsPresent ?? null)
    : (selected?.bed.plantsPresent ?? null);
const panelPlanting =
  submitted?.plantingRecommended !== undefined
    ? (submitted?.plantingRecommended ?? null)
    : (selected?.bed.plantingRecommended ?? null);

// `submitted` is set by a refused save and by an add-slot press alike, and
// both leave something on the page the store does not have yet.
const saveState = submitted ? ADMIN.unsaved : savedFlash ? ADMIN.saved : ADMIN.noUnsaved;
---

<AdminScreen
  title={`${block.referenceAddress} · ${presentation.copy.wordmark}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <form
    method="POST"
    action={langLink(Astro.url.search === '' ? base : `${base}${Astro.url.search}`, lang)}
    data-admin-form
    data-dirty={dirty ? 'true' : undefined}
    class="admin-card"
  >
    {/* The form's DEFAULT button, deliberately first and carrying nothing:
        pressing Enter in the address field submits a plain save. Without it
        the first submit in tree order is "+ ADD SLOT", and Enter would redraw
        the panel with a slot nobody asked for instead of saving. */}
    <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
    <div class={`admin-body mode-${mode}`}>
      <div class="admin-left">
        {/* The steward view has no save button, so it gets no editable
            address either: an Enter in the field there would submit through
            the hidden default button, save the block with no `plate`, and
            drop both the open bed and the steward being read. A view with
            nothing to submit cannot submit the wrong thing. */}
        <label class="addrbar">
          <span class="addr-label" {...bi(ADMIN.refAddress, lang)}>{ADMIN.refAddress[lang]}</span>
          {steward ? (
            <span class="addr-static">{block.referenceAddress}</span>
          ) : (
            <input
              name="referenceAddress"
              maxlength={MAX_ADDRESS_CHARS}
              value={submitted ? submitted.address : block.referenceAddress}
              autocomplete="off"
            />
          )}
          {/* SAVE CHANGES stands beside the address only once a bed is open.
              Without one the field's only commit path is Enter, which nothing
              on screen offers — least of all a phone keyboard's Go key. */}
          {!steward && !selected && (
            <button class="addr-save" type="submit" {...bi(ADMIN.saveAddress, lang)}>
              {ADMIN.saveAddress[lang]}
            </button>
          )}
        </label>
        <div class="blockmeta">
          {
            block.demo && (
              <span class="badge b-demo" {...bi(ADMIN.demoBadge, lang)}>
                {ADMIN.demoBadge[lang]}
              </span>
            )
          }
        </div>
        {
          flash && (
            <div class="deleted-flash" {...bi(flash, lang)}>
              {flash[lang]}
            </div>
          )
        }

        <div class="street">
          {
            beds.map((b) => {
              const state = bedState(b);
              const name = bedRowName(b.bed);
              const guard = guardLabel(b.bed.guard);
              return (
                <a class:list={['tree', { sel: b.bed.plate === selected?.bed.plate }]} href={bedLink(b.bed.plate)}>
                  <span class={`dot ${state.dot}`} />
                  <span class="nm">
                    <span {...bi(name, lang)}>{name[lang]}</span>
                    <small>
                      {b.bed.plate} · <span {...bi(guard, lang)}>{guard[lang]}</span>
                    </small>
                  </span>
                  <span class:list={['badge', state.badgeClass]} {...bi(state.badge, lang)}>
                    {state.badge[lang]}
                  </span>
                </a>
              );
            })
          }
        </div>

        <div class="legend">
          <span
            ><i class="dot-adopted"></i><span {...bi(ADMIN.legendAdopted, lang)}
              >{ADMIN.legendAdopted[lang]}</span
            ></span
          >
          <span
            ><i class="dot-open"></i><span {...bi(ADMIN.legendOpen, lang)}
              >{ADMIN.legendOpen[lang]}</span
            ></span
          >
          <span
            ><i class="dot-closed"></i><span {...bi(ADMIN.legendClosed, lang)}
              >{ADMIN.legendClosed[lang]}</span
            ></span
          >
        </div>

        <a class="add-bed" href={langLink(`${base}/add-bed`, lang)} {...bi(ADMIN.addBed, lang)}
          >{ADMIN.addBed[lang]}</a
        >

        {/* The deleted beds, below and apart from the street: a delete is a
            retirement, so a mis-tap has a way back that needs no deploy — the
            tag registry is checked in and cannot be rewritten at runtime. A
            retired row is NOT a link to the panel; RESTORE is all it offers. */}
        {
          retired.length > 0 && (
            <div class="retired">
              <div class="retired-head" {...bi(ADMIN.retiredHead, lang)}>
                {ADMIN.retiredHead[lang]}
              </div>
              <p class="retired-note" {...bi(ADMIN.retiredNote, lang)}>
                {ADMIN.retiredNote[lang]}
              </p>
              <div class="retired-list">
                {retired.map((b) => {
                  const name = bedRowName(b);
                  return (
                    <div class="tree retired-row">
                      <span class="dot dot-closed" />
                      <span class="nm">
                        <span {...bi(name, lang)}>{name[lang]}</span>
                        <small>{b.plate}</small>
                      </span>
                      <a
                        class="restore-act"
                        href={langLink(`${base}/restore-bed?bed=${b.plate}`, lang)}
                        {...bi(ADMIN.restoreBed, lang)}
                      >
                        {ADMIN.restoreBed[lang]}
                      </a>
                    </div>
                  );
                })}
              </div>
            </div>
          )
        }
      </div>

      <div class="admin-right">
        {
          selected && steward ? (
            <>
              <a class="admin-backlink admin-backlink--always" href={bedLink(selected.bed.plate)}>
                ← <span {...bi(bedHeadingName(selected.bed), lang)}>{bedHeadingName(selected.bed)[lang]}</span>
              </a>
              <div class="who">
                {publicHandle(steward.user)}
                <small>
                  {publicInitials(steward.user)} ·{' '}
                  <span {...bi(sinceLabel(new Date(steward.adoption.adoptedAt)), lang)}>
                    {sinceLabel(new Date(steward.adoption.adoptedAt))[lang]}
                  </span>
                </small>
              </div>
              <dl class="kv">
                <div>
                  <dt {...bi(ADOPT.firstName, lang)}>{ADOPT.firstName[lang]}</dt>
                  <dd>{steward.user.firstName}</dd>
                </div>
                <div>
                  <dt {...bi(ADOPT.lastName, lang)}>{ADOPT.lastName[lang]}</dt>
                  <dd>{steward.user.lastName}</dd>
                </div>
                <div>
                  <dt {...bi(ADMIN.username, lang)}>{ADMIN.username[lang]}</dt>
                  <dd>{publicHandle(steward.user)}</dd>
                </div>
                <div>
                  <dt {...bi(ADOPT.email, lang)}>{ADOPT.email[lang]}</dt>
                  {steward.user.email === '' ? (
                    <dd class="none" {...bi(ADMIN.noContactValue, lang)}>
                      {ADMIN.noContactValue[lang]}
                    </dd>
                  ) : (
                    <dd>{steward.user.email}</dd>
                  )}
                </div>
                <div>
                  <dt {...bi(ADOPT.phone, lang)}>{ADOPT.phone[lang]}</dt>
                  {steward.user.phone === '' ? (
                    <dd class="none" {...bi(ADMIN.noContactValue, lang)}>
                      {ADMIN.noContactValue[lang]}
                    </dd>
                  ) : (
                    <dd>{steward.user.phone}</dd>
                  )}
                </div>
                <div>
                  <dt {...bi(ADMIN.kvKind, lang)}>{ADMIN.kvKind[lang]}</dt>
                  <dd
                    {...bi(
                      steward.adoption.stewardKind === 'pen-and-paper' ? ADMIN.kindPaper : ADMIN.kindNfc,
                      lang,
                    )}
                  >
                    {(steward.adoption.stewardKind === 'pen-and-paper' ? ADMIN.kindPaper : ADMIN.kindNfc)[lang]}
                  </dd>
                </div>
              </dl>
              {steward.user.email === '' && (
                <p class="pii" {...bi(ADMIN.noEmailNote, lang)}>
                  {ADMIN.noEmailNote[lang]}
                </p>
              )}
              {/* The recovery path for a digest opt-out (the emailed
                  unsubscribe link is the only other writer of the flag,
                  and a mail scanner can trip it without the steward
                  knowing). Its own form rather than a SAVE CHANGES row —
                  it belongs to the steward, not to the opened bed — and
                  that form is a SIBLING of the admin card (below), because
                  a form inside a form is dropped by every parser, which
                  would hand this button to the block save instead. The
                  `form` attribute is what keeps it working with no script. */}
              {steward.user.digestOptedOut && (
                <div class="digest-resume">
                  <p class="pii" {...bi(ADMIN.digestOptedOutNote, lang)}>
                    {ADMIN.digestOptedOutNote[lang]}
                  </p>
                  <p class="pii" {...bi(ADMIN.digestResumeSub, lang)}>
                    {ADMIN.digestResumeSub[lang]}
                  </p>
                  <button
                    class="btn btn-outline"
                    type="submit"
                    form="digest-resume-form"
                    {...bi(ADMIN.digestResume, lang)}
                  >
                    {ADMIN.digestResume[lang]}
                  </button>
                </div>
              )}
            </>
          ) : selected ? (
            <>
              <a class="admin-backlink" href={langLink(base, lang)}>
                ← {block.referenceAddress}
              </a>
              <div class="panel-title" {...bi(bedHeadingName(selected.bed), lang)}>
                {bedHeadingName(selected.bed)[lang]}
              </div>
              <div class="idline">
                {selected.bed.plantingSpaceId === null ? (
                  <span {...bi(ADMIN.nycUnresolved, lang)}>{ADMIN.nycUnresolved[lang]}</span>
                ) : (
                  <>#{selected.bed.plantingSpaceId}</>
                )}{' '}
                · <span {...bi(ADMIN.oursLabel, lang)}>{ADMIN.oursLabel[lang]}</span>{' '}
                {selected.bed.plate}
              </div>
              <input type="hidden" name="plate" value={selected.bed.plate} />

              {/* The bed's open report, read-only. A report filed at the tag
                  is SEEN here — the public FAQ says so — and that is all this
                  block does: nothing on it writes, and closing the report
                  stays the steward's act on their own view. */}
              <div class="panel-title report-head" {...bi(ADMIN.reportHead, lang)}>
                {ADMIN.reportHead[lang]}
              </div>
              {openReport ? (
                <div class="report-band">
                  <div class="report-cats">
                    {openReport.problems.map((problem) => (
                      <span class="report-cat" {...bi(problem.label, lang)}>
                        {problem.label[lang]}
                      </span>
                    ))}
                    {openReport.photo && (
                      <span class="report-cat report-photo" {...bi(ADMIN.reportPhoto, lang)}>
                        {ADMIN.reportPhoto[lang]}
                      </span>
                    )}
                  </div>
                  {openReport.note !== '' && <p class="report-note">“{openReport.note}”</p>}
                  <div class="report-meta">
                    <span {...bi(openReport.opened, lang)}>{openReport.opened[lang]}</span> ·{' '}
                    <span {...bi(openReport.confirmations, lang)}>{openReport.confirmations[lang]}</span>
                  </div>
                  {/* The stored photos this report carried — what "Photo
                      attached" means now that photos are kept. Admin-only:
                      this panel is the one surface that renders them. */}
                  {openReportPhotos.length > 0 && (
                    <AdminPhotoGrid
                      photos={openReportPhotos}
                      base={base}
                      showAllPhotos={showAllPhotos}
                      lang={lang}
                    />
                  )}
                  {openReport.alsoSaid.length > 0 && (
                    <div class="report-also">
                      <div class="report-also-title" {...bi(ADMIN.reportAlsoSaid, lang)}>
                        {ADMIN.reportAlsoSaid[lang]}
                      </div>
                      <ul class="report-also-list">
                        {openReport.alsoSaid.map(({ problems, note }) => (
                          <li>
                            {problems.length > 0 && (
                              <span class="report-also-cats">
                                <span {...bi(ADMIN.reportAlsoReported, lang)}>
                                  {ADMIN.reportAlsoReported[lang]}
                                </span>{' '}
                                {problems.map((problem, i) => (
                                  <Fragment>
                                    {i > 0 && <span class="report-also-sep">·</span>}
                                    <span {...bi(problem.label, lang)}>{problem.label[lang]}</span>
                                  </Fragment>
                                ))}
                              </span>
                            )}
                            {note !== '' && <span class="report-also-note">“{note}”</span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              ) : (
                <div class="blockmeta" {...bi(ADMIN.noOpenReport, lang)}>
                  {ADMIN.noOpenReport[lang]}
                </div>
              )}

              {/* Photos from reports since closed: kept as the bed's history
                  (a photo stays with its report when the report closes), each
                  still deletable — moderation does not expire. */}
              {earlierPhotos.length > 0 && (
                <>
                  <div class="panel-title photos-head" {...bi(ADMIN.photosEarlierHead, lang)}>
                    {ADMIN.photosEarlierHead[lang]}
                  </div>
                  <div class="blockmeta" {...bi(ADMIN.photosEarlierNote, lang)}>
                    {ADMIN.photosEarlierNote[lang]}
                  </div>
                  <AdminPhotoGrid
                    photos={earlierPhotos}
                    base={base}
                    showAllPhotos={showAllPhotos}
                    lang={lang}
                  />
                  {olderPhotosHidden > 0 && (
                    <a
                      class="photos-older"
                      href={langLink(`${base}?bed=${selected.bed.plate}&photos=all`, lang)}
                      {...bi(ADMIN.photosShowOlder, lang)}
                    >
                      {ADMIN.photosShowOlder[lang]}
                    </a>
                  )}
                </>
              )}

              {/* Only a NAMED bed gets this row: the switch removes the
                  first steward's name from the public screens (visitor free
                  text on a street is an abuse surface, and taking one down
                  must not touch the bed or the adoption). Committed by SAVE
                  CHANGES; an unnamed bed renders exactly as before. */}
              {selected.bed.bedName !== null && (
                <label class="toggle-row guard-row">
                  <span>
                    <span class="t-lbl">
                      <span {...bi(ADMIN.bedNameLabel, lang)}>{ADMIN.bedNameLabel[lang]}</span>
                      {` · “${selected.bed.bedName}”`}
                    </span>
                    <span class="t-sub">
                      <span {...bi(ADMIN.clearBedNameSub, lang)}>{ADMIN.clearBedNameSub[lang]}</span>
                    </span>
                  </span>
                  <input
                    type="checkbox"
                    class="sw"
                    name="clear-bed-name"
                    value="1"
                    checked={submitted ? submitted.clearName : false}
                  />
                </label>
              )}

              {/* The captain's own framing, as one control: "guard there yes
                  or no, and if there is a guard there, whether it wood or
                  metal". Three radios, so no state can say "a guard, material
                  unset" — and a plain submit carries it with no script. A bed
                  nobody has recorded yet (types.ts) has no radio checked and
                  says so in its sub-line until the admin picks one. */}
              <div class="toggle-row choice-row guard-row">
                <span>
                  <span class="t-lbl" id="guard-choice-label">
                    <span {...bi(ADMIN.guardChoice, lang)}>{ADMIN.guardChoice[lang]}</span>
                    {panelGuard === null && (
                      <span class="unset-mark" {...bi(ADMIN.unsetMark, lang)}>
                        {ADMIN.unsetMark[lang]}
                      </span>
                    )}
                  </span>
                  <span class="t-sub">
                    {panelGuard === null ? (
                      <span {...bi(ADMIN.guardUnsetSub, lang)}>{ADMIN.guardUnsetSub[lang]}</span>
                    ) : (
                      <span {...bi(ADMIN.guardChoiceSub, lang)}>{ADMIN.guardChoiceSub[lang]}</span>
                    )}
                  </span>
                </span>
                {/* The group's own name reaches assistive tech through the
                    label beside it: without it three radios announce as
                    "None"/"Wood"/"Metal" with nothing saying what they set.
                    Markup only — the submit stays a plain scriptless POST. */}
                <span class="seg" role="radiogroup" aria-labelledby="guard-choice-label">
                  {GUARD_MATERIALS.map((material) => (
                    <label class="seg-opt">
                      <input
                        type="radio"
                        name="guard"
                        value={material}
                        checked={panelGuard === material}
                      />
                      <span {...bi(GUARD_OPTION[material], lang)}>{GUARD_OPTION[material][lang]}</span>
                    </label>
                  ))}
                  {/* The way back to NOT YET RECORDED. The absence of a radio
                      cannot be the control — it is already what a stale page
                      submits — so taking a fact back is a choice of its own. */}
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="guard"
                      value={UNRECORDED_CHOICE}
                      checked={panelGuard === null}
                    />
                    <span {...bi(ADMIN.optUnrecorded, lang)}>{ADMIN.optUnrecorded[lang]}</span>
                  </label>
                </span>
              </div>

              {/* The bed profile: what the public "About this bed" page
                  states. Switches for the facts, short typed notes for the
                  admin's own words — all committed by SAVE CHANGES. */}
              <div class="panel-title profile-head" {...bi(ADMIN.profileHead, lang)}>
                {ADMIN.profileHead[lang]}
              </div>
              <div class="blockmeta" {...bi(ADMIN.profileHint, lang)}>
                {ADMIN.profileHint[lang]}
              </div>

              {/* The species. Typed rather than three-way, because it is a
                  name: the 20 fresh named-run beds seed with none at all
                  (checked-in-beds.ts, "i will update it to match NYC parks";
                  the two renamed onto existing beds keep their species)
                  and this is where the captain records one. Same rules as
                  the add-bed form (`resolveSpecies`): the Spanish name is
                  optional and fills itself in for a known species, and a
                  cleared English name takes the species back to NOT YET
                  RECORDED rather than storing an empty word inside the door
                  frame. The one difference is that both fields arrive
                  PRE-FILLED here, so a Spanish name the table itself gave the
                  stored species is re-derived when the English name changes
                  — the save decides that, against what the bed holds. */}
              <div class="species-row">
                <span class="t-lbl">
                  <span {...bi(ADMIN.speciesHead, lang)}>{ADMIN.speciesHead[lang]}</span>
                  {speciesUnset && (
                    <span class="unset-mark" {...bi(ADMIN.unsetMark, lang)}>
                      {ADMIN.unsetMark[lang]}
                    </span>
                  )}
                </span>
                <span class="t-sub">
                  {speciesUnset ? (
                    <span {...bi(ADMIN.speciesUnsetSub, lang)}>{ADMIN.speciesUnsetSub[lang]}</span>
                  ) : (
                    <span {...bi(ADMIN.speciesSub, lang)}>{ADMIN.speciesSub[lang]}</span>
                  )}
                </span>
                <div class="note-field">
                  <label class="field-label" for="tree-type-en" {...bi(ADMIN.treeTypeEn, lang)}>
                    {ADMIN.treeTypeEn[lang]}
                  </label>
                  <input
                    class="field-input"
                    id="tree-type-en"
                    name="tree-type-en"
                    type="text"
                    maxlength={MAX_TREE_TYPE_CHARS}
                    value={panelSpecies.en}
                  />
                </div>
                <div class="note-field">
                  <label class="field-label" for="tree-type-es">
                    <span {...bi(ADMIN.treeTypeEs, lang)}>{ADMIN.treeTypeEs[lang]}</span>{' '}
                    <span class="field-note">
                      ·{' '}
                      <span {...bi(ADMIN.treeTypeEsStored, lang)}>
                        {ADMIN.treeTypeEsStored[lang]}
                      </span>
                    </span>
                  </label>
                  <input
                    class="field-input"
                    id="tree-type-es"
                    name="tree-type-es"
                    type="text"
                    maxlength={MAX_TREE_TYPE_CHARS}
                    value={panelSpecies.es}
                  />
                </div>
              </div>
              {/* Three-way, like the guard and the two rows below: a checkbox
                  cannot tell "unchecked" from "not sent", and the public page
                  must say nothing about the tree until somebody has stood at
                  the bed and said. NOT RECORDED is the way back. */}
              <div class="toggle-row choice-row">
                <span>
                  <span class="t-lbl" id="tree-present-label">
                    <span {...bi(ADMIN.treePresentToggle, lang)}>{ADMIN.treePresentToggle[lang]}</span>
                    {panelTree === null && (
                      <span class="unset-mark" {...bi(ADMIN.unsetMark, lang)}>
                        {ADMIN.unsetMark[lang]}
                      </span>
                    )}
                  </span>
                  <span class="t-sub">
                    {panelTree === null ? (
                      <span {...bi(ADMIN.treePresentUnsetSub, lang)}>
                        {ADMIN.treePresentUnsetSub[lang]}
                      </span>
                    ) : (
                      <span {...bi(ADMIN.treePresentSub, lang)}>{ADMIN.treePresentSub[lang]}</span>
                    )}
                  </span>
                </span>
                <span class="seg" role="radiogroup" aria-labelledby="tree-present-label">
                  <label class="seg-opt">
                    <input type="radio" name="tree-present" value="yes" checked={panelTree === true} />
                    <span {...bi(ADMIN.treeOptYes, lang)}>{ADMIN.treeOptYes[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input type="radio" name="tree-present" value="no" checked={panelTree === false} />
                    <span {...bi(ADMIN.treeOptNo, lang)}>{ADMIN.treeOptNo[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="tree-present"
                      value={UNRECORDED_CHOICE}
                      checked={panelTree === null}
                    />
                    <span {...bi(ADMIN.optUnrecorded, lang)}>{ADMIN.optUnrecorded[lang]}</span>
                  </label>
                </span>
              </div>
              {/* Three-way, like the guard: a bed nobody has recorded has no
                  radio checked and the public page stays silent about it,
                  rather than publishing "nothing planted yet" by default. */}
              <div class="toggle-row choice-row">
                <span>
                  <span class="t-lbl" id="plants-present-label">
                    <span {...bi(ADMIN.plantsPresentToggle, lang)}>{ADMIN.plantsPresentToggle[lang]}</span>
                    {panelPlants === null && (
                      <span class="unset-mark" {...bi(ADMIN.unsetMark, lang)}>
                        {ADMIN.unsetMark[lang]}
                      </span>
                    )}
                  </span>
                  <span class="t-sub">
                    {panelPlants === null ? (
                      <span {...bi(ADMIN.plantsPresentUnsetSub, lang)}>
                        {ADMIN.plantsPresentUnsetSub[lang]}
                      </span>
                    ) : (
                      <span {...bi(ADMIN.plantsPresentSub, lang)}>{ADMIN.plantsPresentSub[lang]}</span>
                    )}
                  </span>
                </span>
                <span class="seg" role="radiogroup" aria-labelledby="plants-present-label">
                  <label class="seg-opt">
                    <input type="radio" name="plants-present" value="yes" checked={panelPlants === true} />
                    <span {...bi(ADMIN.plantsOptYes, lang)}>{ADMIN.plantsOptYes[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input type="radio" name="plants-present" value="no" checked={panelPlants === false} />
                    <span {...bi(ADMIN.plantsOptNo, lang)}>{ADMIN.plantsOptNo[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="plants-present"
                      value={UNRECORDED_CHOICE}
                      checked={panelPlants === null}
                    />
                    <span {...bi(ADMIN.optUnrecorded, lang)}>{ADMIN.optUnrecorded[lang]}</span>
                  </label>
                </span>
              </div>
              <div class="note-field">
                <label class="field-label" for="plants-note" {...bi(ADMIN.plantsNoteLabel, lang)}>
                  {ADMIN.plantsNoteLabel[lang]}
                </label>
                <textarea
                  class="freetext"
                  id="plants-note"
                  name="plants-note"
                  rows="2"
                  maxlength={MAX_BED_NOTE_CHARS}
                >{submitted?.plantsNote ?? selected.bed.plantsNote}</textarea>
              </div>
              <div class="toggle-row choice-row">
                <span>
                  <span class="t-lbl" id="planting-recommended-label">
                    <span {...bi(ADMIN.plantingRecommendedToggle, lang)}>
                      {ADMIN.plantingRecommendedToggle[lang]}
                    </span>
                    {panelPlanting === null && (
                      <span class="unset-mark" {...bi(ADMIN.unsetMark, lang)}>
                        {ADMIN.unsetMark[lang]}
                      </span>
                    )}
                  </span>
                  <span class="t-sub">
                    {panelPlanting === null ? (
                      <span {...bi(ADMIN.plantingRecommendedUnsetSub, lang)}>
                        {ADMIN.plantingRecommendedUnsetSub[lang]}
                      </span>
                    ) : (
                      <span {...bi(ADMIN.plantingRecommendedSub, lang)}>
                        {ADMIN.plantingRecommendedSub[lang]}
                      </span>
                    )}
                  </span>
                </span>
                <span class="seg" role="radiogroup" aria-labelledby="planting-recommended-label">
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="planting-recommended"
                      value="yes"
                      checked={panelPlanting === true}
                    />
                    <span {...bi(ADMIN.plantingOptYes, lang)}>{ADMIN.plantingOptYes[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="planting-recommended"
                      value="no"
                      checked={panelPlanting === false}
                    />
                    <span {...bi(ADMIN.plantingOptNo, lang)}>{ADMIN.plantingOptNo[lang]}</span>
                  </label>
                  <label class="seg-opt">
                    <input
                      type="radio"
                      name="planting-recommended"
                      value={UNRECORDED_CHOICE}
                      checked={panelPlanting === null}
                    />
                    <span {...bi(ADMIN.optUnrecorded, lang)}>{ADMIN.optUnrecorded[lang]}</span>
                  </label>
                </span>
              </div>
              <div class="note-field">
                <label
                  class="field-label"
                  for="recommended-plants-note"
                  {...bi(ADMIN.recommendedPlantsLabel, lang)}
                >
                  {ADMIN.recommendedPlantsLabel[lang]}
                </label>
                <textarea
                  class="freetext"
                  id="recommended-plants-note"
                  name="recommended-plants-note"
                  rows="2"
                  maxlength={MAX_BED_NOTE_CHARS}
                >{submitted?.recommendedPlantsNote ?? selected.bed.recommendedPlantsNote}</textarea>
              </div>
              <div class="note-field">
                <label class="field-label" for="care-note" {...bi(ADMIN.careNoteLabel, lang)}>
                  {ADMIN.careNoteLabel[lang]}
                </label>
                <textarea
                  class="freetext"
                  id="care-note"
                  name="care-note"
                  rows="2"
                  maxlength={MAX_BED_NOTE_CHARS}
                >{submitted?.careNote ?? selected.bed.careNote}</textarea>
              </div>

              <div class="panel-title slots-head" {...bi(slotsFilledLabel(selected.stewards.length, panelSlots), lang)}>
                {slotsFilledLabel(selected.stewards.length, panelSlots)[lang]}
              </div>
              {slotError && (
                <div class="field-error" {...bi(slotError, lang)}>
                  {slotError[lang]}
                </div>
              )}
              {Array.from({ length: panelSlots }, (_, i) => i + 1).map((i) => {
                const filled = selected.stewards[i - 1];
                if (filled) {
                  const short =
                    filled.adoption.stewardKind === 'pen-and-paper'
                      ? ADMIN.badgePaperShort
                      : ADMIN.badgeNfcShort;
                  return (
                    <div class="slotline">
                      <span>
                        <span {...bi(ADMIN.slotWord, lang)}>{ADMIN.slotWord[lang]}</span> {i} ·{' '}
                        {publicHandle(filled.user)}
                      </span>
                      <span
                        class:list={[
                          'badge',
                          filled.adoption.stewardKind === 'pen-and-paper' ? 'badge-paper' : 'badge-nfc',
                        ]}
                        {...bi(short, lang)}
                      >
                        {short[lang]}
                      </span>
                    </div>
                  );
                }
                const offered = submitted ? submitted.slots.has(i) : i <= selected.bed.offeredSlots;
                const word = offered ? ADMIN.slotOpen : ADMIN.slotNotOffered;
                return (
                  <label class="slotline">
                    <span>
                      <span {...bi(ADMIN.slotWord, lang)}>{ADMIN.slotWord[lang]}</span> {i} ·{' '}
                      <span {...bi(word, lang)}>{word[lang]}</span>
                    </span>
                    <input type="checkbox" class="sw" name="slot-open" value={i} checked={offered} />
                  </label>
                );
              })}
              {submitted && submitted.addSlots > 0 && (
                <input type="hidden" name="add-slot" value={panelSlots - selected.bed.slots} />
              )}
              {panelSlots < MAX_BED_SLOTS && (
                <button class="slotline-act" type="submit" name="intent" value="add-slot" {...bi(ADMIN.addSlot, lang)}>
                  {ADMIN.addSlot[lang]}
                </button>
              )}

              <div class="panel-title stewards-head" {...bi(COMMON.stewards, lang)}>
                {COMMON.stewards[lang]}
              </div>
              {selected.stewards.map(({ adoption, user }) => {
                const since = sinceLabel(new Date(adoption.adoptedAt));
                return (
                  <a
                    class="stewrow"
                    href={langLink(`${base}?bed=${selected.bed.plate}&steward=${user.id}`, lang)}
                  >
                    <span class="av">{publicInitials(user).replace(/[.\s]/g, '')}</span>
                    <span class="av-lbl">
                      {publicHandle(user)}
                      <small>
                        {publicInitials(user)} · <span {...bi(since, lang)}>{since[lang]}</span>
                      </small>
                    </span>
                    <span class="go">›</span>
                  </a>
                );
              })}
              {selected.stewards.length < selected.bed.slots && (
                <a
                  class="slotline-act add-steward"
                  href={langLink(`${base}/add-steward?bed=${selected.bed.plate}`, lang)}
                  {...bi(ADMIN.addStewardLink, lang)}
                >
                  {ADMIN.addStewardLink[lang]}
                </a>
              )}
              <div class="blockmeta" {...bi(ADMIN.stewardHint, lang)}>
                {ADMIN.stewardHint[lang]}
              </div>

              <div class="panel-spacer" />
              <button class="btn btn-action save-btn" type="submit" {...bi(ADMIN.save, lang)}>
                {ADMIN.save[lang]}
              </button>
              <div
                class="save-state"
                data-save-state
                data-unsaved-en={ADMIN.unsaved.en}
                data-unsaved-es={ADMIN.unsaved.es}
                {...bi(saveState, lang)}
              >
                {saveState[lang]}
              </div>
              <p class="pii" {...bi(ADMIN.piiNote, lang)}>
                {ADMIN.piiNote[lang]}
              </p>
              {/* A LINK, deliberately: it opens the confirmation page and
                  writes nothing, so a mis-tap on a phone costs a navigation.
                  The delete itself is the confirmation page's own POST. */}
              <a
                class="delete-bed"
                href={langLink(`${base}/delete-bed?bed=${selected.bed.plate}`, lang)}
                {...bi(ADMIN.deleteBedLink, lang)}
              >
                {ADMIN.deleteBedLink[lang]}
              </a>
            </>
          ) : (
            <div class="blockmeta select-hint" {...bi(ADMIN.selectBed, lang)}>
              {ADMIN.selectBed[lang]}
            </div>
          )
        }
      </div>
    </div>
  </form>
  {/* The steward detail's RESUME THEIR DIGEST form, kept outside the admin
      card so the two are siblings rather than nested; its button lives in
      the panel above and reaches it by `form`. */}
  {selected && steward && steward.user.digestOptedOut && (
    <form
      id="digest-resume-form"
      method="POST"
      action={langLink(`${base}/steward-digest`, lang)}
      hidden
    >
      <input type="hidden" name="bed" value={selected.bed.plate} />
      <input type="hidden" name="steward" value={steward.user.id} />
    </form>
  )}
</AdminScreen>

<style>
  /* The approved screens draw add-affordances as a dashed box with the
     action ink, not as a street button — this page is chrome, not a plaque. */
  .add-bed {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border: 2px dashed var(--theme-border);
    border-radius: 9px;
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--theme-action);
    background: transparent;
    text-decoration: none;
  }
  .guard-row {
    margin-top: 16px;
  }
  /* "Not set" beside a three-way row's label — the guard and the two profile
