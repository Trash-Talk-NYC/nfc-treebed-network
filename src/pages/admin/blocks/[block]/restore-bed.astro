---
// "RESTORE", confirmed on a page of its own — the same shape as the delete
// beside it, for a different reason. The deleted rows sit under the block
// page's one big form, so a submit there is the form's submit: it would
// disarm the unsaved-changes guard and drop whatever the captain still had
// open in the bed panel. A plain link out of the page cannot, and the browser
// asks about the pending edits exactly as it does for every other navigation.
// No script is involved either way.
//
// What the press does is clear `retiredAt` (service.ts, `restoreBedByAdmin`)
// and nothing else: guard dates, offered slots, stewards, reports and events
// were never touched by the retirement, so the bed and its still-bound tag
// come back as they were, with no deploy.
import AdminScreen from '../../../../layouts/AdminScreen.astro';
import { refuseAdminWithBody, requireAdmin } from '../../../../lib/admin-route';
import { bi } from '../../../../lib/bilingual';
import { ADMIN } from '../../../../lib/copy';
import { bedHeadingName } from '../../../../lib/format';
import { langLink, resolveLang, type Lang } from '../../../../lib/i18n';
import { presentationFor } from '../../../../lib/presentation';
import { abandonBody } from '../../../../lib/request-body';
import { RuleError, restoreBedByAdmin } from '../../../../lib/service';
import { getStore } from '../../../../lib/store';

const lang: Lang = resolveLang(Astro.url, Astro.cookies);
const gate = await requireAdmin(Astro.request, Astro.cookies, langLink('/admin', lang));
if (gate.refused) return gate.refused;

const store = getStore();
const blockId = Astro.params.block ?? '';
const plate = Astro.url.searchParams.get('bed') ?? '';
const base = `/admin/blocks/${blockId}`;

const block = await store.getBlock(blockId);
const bed = plate === '' ? null : await store.getBed(plate);
if (!block || !bed || bed.blockId !== blockId) {
  return await refuseAdminWithBody(Astro.request, new Response('Not found.', { status: 404 }));
}
// Already back — a stale tab, or a resubmitted confirmation. The honest answer
// is the block page the bed is on again, not a 404 for a bed that is fine.
if (bed.retiredAt === null) {
  await abandonBody(Astro.request);
  if (Astro.request.method === 'POST') {
    const params = new URLSearchParams({ restored: '1' });
    return Astro.redirect(langLink(`${base}?${params}`, lang), 303);
  }
  return Astro.redirect(langLink(base, lang), 302);
}

if (Astro.request.method === 'POST') {
  // The press carries no fields — the bed is named by the URL this page
  // validated — so there is nothing to read, only the body to account for.
  await abandonBody(Astro.request);
  try {
    await restoreBedByAdmin(store, { blockId, plate });
  } catch (err) {
    if (err instanceof RuleError && err.code === 'bed-not-found') {
      return new Response('Not found.', { status: 404 });
    }
    throw err;
  }
  // Back to the LIST, not to the bed's panel: the confirmation renders in the
  // list column, which the phone breakpoint hides whenever `?bed=` opens the
  // panel — and what a restore has to show is the bed back among the others.
  // Same landing as a delete, which is the same fact in the other direction.
  const params = new URLSearchParams({ restored: '1' });
  return Astro.redirect(langLink(`${base}?${params}`, lang), 303);
}

const presentation = presentationFor(bed);
const heading = bedHeadingName(bed);
const blockLink = langLink(base, lang);
---

<AdminScreen
  title={`${ADMIN.restoreBedTitle[lang]} · ${presentation.copy.wordmark}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="admin-narrow restore-form">
    <a class="admin-backlink admin-backlink--always" href={blockLink}>
      ← {block.referenceAddress}
    </a>
    <h1 class="admin-title" {...bi(ADMIN.restoreBedTitle, lang)}>{ADMIN.restoreBedTitle[lang]}</h1>
    <div class="panel-title" {...bi(heading, lang)}>{heading[lang]}</div>
    <div class="idline">
      {
        bed.plantingSpaceId === null ? (
          <span {...bi(ADMIN.nycUnresolved, lang)}>{ADMIN.nycUnresolved[lang]}</span>
        ) : (
          <>#{bed.plantingSpaceId}</>
        )
      }{' '}
      · <span {...bi(ADMIN.oursLabel, lang)}>{ADMIN.oursLabel[lang]}</span>{' '}
      {plate}
    </div>
    <p class="body-copy" {...bi(ADMIN.restoreBedBody, lang)}>{ADMIN.restoreBedBody[lang]}</p>
    <form method="POST" action={langLink(`${base}/restore-bed?bed=${plate}`, lang)}>
      <button class="btn btn-tall btn-action" type="submit" {...bi(ADMIN.restoreBedSubmit, lang)}>
        {ADMIN.restoreBedSubmit[lang]}
      </button>
    </form>
    <a class="btn btn-outline" href={blockLink} {...bi(ADMIN.restoreBedCancel, lang)}>
      {ADMIN.restoreBedCancel[lang]}
    </a>
  </div>
</AdminScreen>

<style>
  .restore-form {
    margin: 0 auto;
  }
</style>
