---
// One short form. The whole of what it takes to put your name on a bed.
//
// Four fields, exactly as the approved screens draw them: first name, last
// name, email, and a phone the captain's own gap note made optional ("Right
// now the form refuses to submit without one, which costs signups on a
// sidewalk"). The single "YOUR NAME" field the old form had is split in two,
// which was the other gap note.
//
// A fifth, optional field appears for the FIRST steward only, and is the one
// thing here the approved screens do not draw: naming the bed ("the first
// adopter names the bed"). It sits below the contact fields and above the
// bottom-pinned submit, so it never crowds the button.
//
// **No password, no PIN, no code.** The captain's passwordless decision
// superseded the PIN plan, and ordered the field, the column and the
// username+PIN screen dropped. Three reasons, all of which a secret here would
// undo: a forgotten one is permanent lockout with no recovery path; a cloned
// plaque on a public repo hands an attacker a reusable secret to harvest; and
// a short code on a street object has no brute-force protection. The handle
// shown on the plaque is derived from the name instead (`deriveUsername`).
//
// What carries a steward from here is the session cookie set below, which
// lasts a year — sign-in is rare precisely because of it. The tap-to-sign-in
// link that replaces the PIN screens is `adopt-name-split-r5` and needs the
// org's Brevo account, so it is NOT built here. Until it lands, a steward who
// clears cookies has no way back in; that gap is stated in the PR rather than
// closed with the secret the captain removed. The existing `/auth` screens are
// left alone for the same reason — migrating them is that task too.
//
// Email and phone are PII: stored, never displayed anywhere public, never
// echoed into any client payload. Only the username and the initials are
// public, and the sentence on the form says so — with NO privacy policy link,
// because there is no policy yet and a dead link on a form collecting contact
// details is worse than none (design-record.md, answered open question 1).
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import {
  MAX_BED_NAME_CHARS,
  MAX_EMAIL_CHARS,
  MAX_NAME_CHARS,
  RuleError,
  adoptBed,
  getBedView,
  validateAdoptInput,
  type AdoptErrors,
} from '../../../lib/service';
import { setSessionUser } from '../../../lib/session';
import { MAX_FORM_BYTES, readFormOrRefuse } from '../../../lib/request-body';
import { bi } from '../../../lib/bilingual';
import { capitalizeFirst, slotsAllTakenMessage, slotsJustFilledMessage } from '../../../lib/format';
import { ADOPT, ADOPT_ERRORS, COMMON } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseMissingBedScreen, requireBoundTagForForm } from '../../../lib/tag-route';
import type { Phrase } from '../../../lib/i18n';

const { bound, refused: notBound } = await requireBoundTagForForm(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
// The bed behind a bound tag can legitimately go away: a delete on the admin
// page retires it (service.ts). Every sub-page sends the visitor to the door
// screen for that, which is where the calm "not assigned to a bed yet" screen
// lives and which answers 404 itself.
if (!view) return await refuseMissingBedScreen(Astro.request, base);

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);
const bed = view.bed;

let openSlots = view.openSlots;
// Why there is nothing to fill in: every physical slot taken, or a slot the
// captain has simply not offered yet. Two different facts, and the screen must
// not tell the visitor the wrong one.
const slotsAllTaken = view.stewards.length >= bed.slots;
const noSlotCopy = (): Phrase =>
  slotsAllTaken ? slotsAllTakenMessage(bed.slots) : ADOPT.noOpenSlot;
// "The first adopter names the bed": the naming field exists only while
// nobody stewards this bed and nobody has named it. A second steward is not
// asked and cannot rename — the field simply is not on their form, and
// `adoptBed` re-decides eligibility inside its transaction so a hand-built or
// raced POST cannot name past this either.
const offerNaming = view.stewards.length === 0 && bed.bedName === null;
let errors: AdoptErrors = {};
let formError: Phrase | null = null;
// Everything the visitor typed, echoed back on a validation failure. All of it
// this time: there is no secret on this form to withhold.
let values = { firstName: '', lastName: '', email: '', phone: '', bedName: '' };

if (Astro.request.method === 'POST') {
  // Public and unauthenticated, like every POST here: five short text fields
  // never need more, and an unbounded body is free memory exhaustion.
  const { form, refused } = await readFormOrRefuse(Astro.request, MAX_FORM_BYTES, 'form');
  // Each reason gets its own answer: a 413 would send somebody off to shorten
  // a form that was never long.
  if (refused) return refused;
  const input = {
    firstName: String(form.get('firstName') ?? ''),
    lastName: String(form.get('lastName') ?? ''),
    email: String(form.get('email') ?? ''),
    phone: String(form.get('phone') ?? ''),
    bedName: String(form.get('bedName') ?? ''),
  };
  const checked = validateAdoptInput(input);
  values = checked.values;
  errors = checked.errors;
  if (Object.keys(errors).length === 0) {
    try {
      const user = await adoptBed(store, { plate, input });
      setSessionUser(Astro.cookies, user.id);
      return Astro.redirect(langLink(`${base}/adopted`, lang), 303);
    } catch (err) {
      if (err instanceof RuleError && err.code === 'slots-full') {
        // The only rule this form can lose to now. Nothing here hashes, so
        // there is no CPU bound left to be shed at, and the handle is derived
        // rather than chosen, so there is no collision to report either.
        // Fully offered, so losing the last slot to somebody else is what
        // just happened; on a bed with a slot held back it never was one.
        formError =
          bed.offeredSlots >= bed.slots ? slotsJustFilledMessage(bed.slots) : ADOPT.noOpenSlot;
        openSlots = 0;
      } else if (err instanceof RuleError && err.code === 'bed-not-found') {
        // Retired between the read above and this transaction: the same calm
        // screen the read itself would have sent them to.
        return await refuseMissingBedScreen(Astro.request, base);
      } else {
        throw err;
      }
    }
  }
}

const treeTypeLabel = {
  en: capitalizeFirst(bed.treeType.en),
  es: capitalizeFirst(bed.treeType.es),
};
---

<Screen
  title={`${ADOPT.title[lang]} · ${capitalizeFirst(bed.treeType[lang])}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="screen">
    <div>
      <a class="back-link" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}
        >{COMMON.backToBed[lang]}</a
      >
      <div class="ident">
        {bed.plantingSpaceId && <>#{bed.plantingSpaceId} · </>}
        <span {...bi(treeTypeLabel, lang)}>{treeTypeLabel[lang]}</span>
      </div>
    </div>
    <h1 class="title" {...bi(ADOPT.title, lang)}>{ADOPT.title[lang]}</h1>
    {
      openSlots === 0 ? (
        <>
          <p class="body-copy" {...bi(formError ?? noSlotCopy(), lang)}>
            {(formError ?? noSlotCopy())[lang]}
          </p>
          <div class="spacer" />
          <a
            class="btn btn-action"
            href={langLink(ourPlaqueLink(base), lang)}
            {...bi(COMMON.backToBed, lang)}
            >{COMMON.backToBed[lang]}</a
          >
        </>
      ) : (
        <form method="POST" action={langLink(`${base}/adopt`, lang)} class="adopt-form">
          {formError && (
            <p class="field-error" {...bi(formError, lang)}>
              {formError[lang]}
            </p>
          )}
          <div class="field-row">
            <div>
              <label class="field-label" for="firstName" {...bi(ADOPT.firstName, lang)}>
                {ADOPT.firstName[lang]}
              </label>
              <input
                class="field-input"
                id="firstName"
                name="firstName"
                type="text"
                maxlength={MAX_NAME_CHARS}
                value={values.firstName}
                autocomplete="given-name"
                required
              />
            </div>
            <div>
              <label class="field-label" for="lastName" {...bi(ADOPT.lastName, lang)}>
                {ADOPT.lastName[lang]}
              </label>
              <input
                class="field-input"
                id="lastName"
                name="lastName"
                type="text"
                maxlength={MAX_NAME_CHARS}
                value={values.lastName}
                autocomplete="family-name"
                required
              />
            </div>
          </div>
          {errors.firstName && (
            <div class="field-error" {...bi(ADOPT_ERRORS.firstName, lang)}>
              {ADOPT_ERRORS.firstName[lang]}
            </div>
          )}
          {errors.lastName && (
            <div class="field-error" {...bi(ADOPT_ERRORS.lastName, lang)}>
              {ADOPT_ERRORS.lastName[lang]}
            </div>
          )}

          <div>
            <label class="field-label" for="email" {...bi(ADOPT.email, lang)}>
              {ADOPT.email[lang]}
            </label>
            <input
              class="field-input"
              id="email"
              name="email"
              type="email"
              maxlength={MAX_EMAIL_CHARS}
              value={values.email}
              autocomplete="email"
              required
            />
            {errors.email && (
              <div class="field-error" {...bi(ADOPT_ERRORS.email, lang)}>
                {ADOPT_ERRORS.email[lang]}
              </div>
            )}
          </div>

          <div>
            <label class="field-label" for="phone">
              <span {...bi(ADOPT.phone, lang)}>{ADOPT.phone[lang]}</span> ·{' '}
              <span class="field-note" {...bi(COMMON.optional, lang)}>{COMMON.optional[lang]}</span>
            </label>
            <input
              class="field-input"
              id="phone"
              name="phone"
              type="tel"
              value={values.phone}
              autocomplete="tel"
            />
            {errors.phone && (
              <div class="field-error" {...bi(ADOPT_ERRORS.phone, lang)}>
                {ADOPT_ERRORS.phone[lang]}
              </div>
            )}
          </div>

          {/* The naming moment — the first steward only ("the first adopter
              names the bed"). Optional and clearly said so: someone mid-walk
              finishes without it and the bed simply has no name. The input is
              set in the plaque type because this is putting a name on
              something, not another contact field; the spacer below still
              pins the submit to the bottom, so nothing crowds the button. */}
          {offerNaming && (
            <div class="bed-name-field">
              <label class="field-label" for="bedName">
                <span {...bi(ADOPT.nameBed, lang)}>{ADOPT.nameBed[lang]}</span> ·{' '}
                <span class="field-note" {...bi(COMMON.optional, lang)}>
                  {COMMON.optional[lang]}
                </span>
              </label>
              <input
                class="field-input bed-name-input"
                id="bedName"
                name="bedName"
                type="text"
                maxlength={MAX_BED_NAME_CHARS}
                value={values.bedName}
                autocomplete="off"
              />
              <p class="body-copy field-help" {...bi(ADOPT.nameBedHelp, lang)}>
                {ADOPT.nameBedHelp[lang]}
              </p>
            </div>
          )}

          {/* Says what the form does NOT ask for, which on a street object is
              the reassuring half: nothing to invent, nothing to forget. */}
          <p class="body-copy field-help" {...bi(ADOPT.noSecret, lang)}>
            {ADOPT.noSecret[lang]}
          </p>

          {/* The privacy sentence, with no link. When there IS a policy, the
              link goes here and nowhere else — one obvious place, left on
              purpose (design-record.md, answered open question 1). */}
          <p class="privacy" {...bi(ADOPT.privacy, lang)}>{ADOPT.privacy[lang]}</p>

          <div class="spacer" />
          <button class="btn btn-tall btn-action" type="submit" {...bi(ADOPT.submit, lang)}>
            {ADOPT.submit[lang]}
          </button>
        </form>
      )
    }
  </div>
</Screen>

<style>
  .adopt-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-height: 0;
  }
  .field-help { font-size: 13px; margin-top: 6px; }
  /* Putting a name on something: the plaque's own face, not a contact field. */
  .bed-name-input {
    font-family: 'Londrina Solid', cursive;
    font-weight: 400;
    font-size: 22px;
  }
  .privacy {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--theme-muted);
  }
</style>
