---
// One short form. The whole of what it takes to put your name on a bed.
//
// Fields, in the order the approved screens show them: first name, last name,
// then the two the captain's own gap notes asked for — the single "YOUR NAME"
// split in two, and the phone made optional ("Right now the form refuses to
// submit without one, which costs signups on a sidewalk").
//
// A username and a PIN sit with them, which the approved screen does not show,
// and this is the one deliberate departure from it. That screen's line reads
// "We'll email you a link to sign in", which is spec §2's magic-link plan — the
// plan the captain later replaced with username + numeric PIN for the street
// MVP (AGENTS.md, "Security decisions"). No email is sent by anything in this
// build, so shipping the screen as drawn would leave every steward created here
// with no way back in at all. The two fields are what the captain's own later
// decision costs, and the copy says plainly what the PIN is for.
//
// Email and phone are PII: stored, never displayed anywhere public, never
// echoed into any client payload. Only the username and the initials are
// public, and the sentence on the form says so — with NO privacy policy link,
// because there is no policy yet and a dead link on a form collecting contact
// details is worse than none (design-record.md, answered open question 1).
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import {
  RuleError,
  adoptBed,
  getBedView,
  validateAdoptInput,
  type AdoptErrors,
} from '../../../lib/service';
import { setSessionUser } from '../../../lib/session';
import { MAX_FORM_BYTES, readFormOrRefuse } from '../../../lib/request-body';
import { bi } from '../../../lib/bilingual';
import { ADOPT, ADOPT_ERRORS, COMMON } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseWithBody, requireBoundTagForForm } from '../../../lib/tag-route';
import type { Phrase } from '../../../lib/i18n';

const { bound, refused: notBound } = await requireBoundTagForForm(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
if (!view) {
  return await refuseWithBody(Astro.request, new Response('No bed with that plate.', { status: 404 }));
}

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);
const bed = view.bed;

let openSlots = view.openSlots;
let errors: AdoptErrors = {};
let formError: Phrase | null = null;
// Values echoed back on validation failure — the PIN deliberately never is.
let values = { firstName: '', lastName: '', username: '', email: '', phone: '' };

if (Astro.request.method === 'POST') {
  // Public and unauthenticated, like every POST here: six short text fields
  // never need more, and an unbounded body is free memory exhaustion.
  const { form, refused } = await readFormOrRefuse(Astro.request, MAX_FORM_BYTES, 'form');
  // Each reason gets its own answer: a 413 would send somebody off to shorten
  // a form that was never long.
  if (refused) return refused;
  const input = {
    firstName: String(form.get('firstName') ?? ''),
    lastName: String(form.get('lastName') ?? ''),
    username: String(form.get('username') ?? ''),
    pin: String(form.get('pin') ?? ''),
    email: String(form.get('email') ?? ''),
    phone: String(form.get('phone') ?? ''),
  };
  const checked = validateAdoptInput(input);
  values = {
    firstName: checked.values.firstName,
    lastName: checked.values.lastName,
    username: checked.values.username,
    email: checked.values.email,
    phone: checked.values.phone,
  };
  errors = checked.errors;
  if (Object.keys(errors).length === 0) {
    try {
      const user = await adoptBed(store, { plate, input });
      setSessionUser(Astro.cookies, user.id);
      return Astro.redirect(langLink(`${base}/adopted`, lang), 303);
    } catch (err) {
      if (err instanceof RuleError && err.code === 'slots-full') {
        formError = ADOPT.slotsJustFilled;
        openSlots = 0;
      } else if (err instanceof RuleError && err.code === 'username-taken') {
        errors.username = 'usernameTaken';
      } else if (err instanceof RuleError && err.code === 'busy') {
        // Shed because too many PIN hashes are already running. The form comes
        // back filled in — everything but the PIN, which is never echoed — so a
        // retry costs one tap rather than the whole field set.
        formError = ADOPT.busy;
        Astro.response.status = 503;
        Astro.response.headers.set('retry-after', '5');
      } else {
        throw err;
      }
    }
  }
}
---

<Screen
  title={`${ADOPT.title[lang]} · ${bed.treeType[lang]}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="screen">
    <div>
      <a class="back-link" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}
        >{COMMON.backToBed[lang]}</a
      >
      <div class="ident">
        {bed.plantingSpaceId && <>#{bed.plantingSpaceId} · </>}
        <span {...bi(bed.treeType, lang)}>{bed.treeType[lang]}</span>
      </div>
    </div>
    <h1 class="title" {...bi(ADOPT.title, lang)}>{ADOPT.title[lang]}</h1>
    {
      openSlots === 0 ? (
        <>
          <p class="body-copy" {...bi(formError ?? ADOPT.full, lang)}>
            {(formError ?? ADOPT.full)[lang]}
          </p>
          <div class="spacer" />
          <a
            class="btn btn-action"
            href={langLink(ourPlaqueLink(base), lang)}
            {...bi(COMMON.backToBed, lang)}
            >{COMMON.backToBed[lang]}</a
          >
        </>
      ) : (
        <form method="POST" class="adopt-form">
          {formError && (
            <p class="field-error" {...bi(formError, lang)}>
              {formError[lang]}
            </p>
          )}
          <div class="field-row">
            <div>
              <label class="field-label" for="firstName" {...bi(ADOPT.firstName, lang)}>
                {ADOPT.firstName[lang]}
              </label>
              <input
                class="field-input"
                id="firstName"
                name="firstName"
                type="text"
                value={values.firstName}
                autocomplete="given-name"
                required
              />
            </div>
            <div>
              <label class="field-label" for="lastName" {...bi(ADOPT.lastName, lang)}>
                {ADOPT.lastName[lang]}
              </label>
              <input
                class="field-input"
                id="lastName"
                name="lastName"
                type="text"
                value={values.lastName}
                autocomplete="family-name"
                required
              />
            </div>
          </div>
          {errors.firstName && (
            <div class="field-error" {...bi(ADOPT_ERRORS.firstName, lang)}>
              {ADOPT_ERRORS.firstName[lang]}
            </div>
          )}
          {errors.lastName && (
            <div class="field-error" {...bi(ADOPT_ERRORS.lastName, lang)}>
              {ADOPT_ERRORS.lastName[lang]}
            </div>
          )}

          <div>
            <label class="field-label" for="username" {...bi(ADOPT.username, lang)}>
              {ADOPT.username[lang]}
            </label>
            <input
              class="field-input"
              id="username"
              name="username"
              type="text"
              placeholder="@"
              value={values.username}
              autocomplete="username"
              autocapitalize="none"
              required
            />
            {errors.username && (
              <div class="field-error" {...bi(ADOPT_ERRORS[errors.username], lang)}>
                {ADOPT_ERRORS[errors.username][lang]}
              </div>
            )}
          </div>

          <div>
            <label class="field-label" for="pin" {...bi(ADOPT.pin, lang)}>
              {ADOPT.pin[lang]}
            </label>
            <input
              class="field-input"
              id="pin"
              name="pin"
              type="password"
              inputmode="numeric"
              autocomplete="new-password"
              required
            />
            {errors.pin && (
              <div class="field-error" {...bi(ADOPT_ERRORS.pin, lang)}>
                {ADOPT_ERRORS.pin[lang]}
              </div>
            )}
            <p class="body-copy field-help" {...bi(ADOPT.pinHelp, lang)}>
              {ADOPT.pinHelp[lang]}
            </p>
          </div>

          <div>
            <label class="field-label" for="email" {...bi(ADOPT.email, lang)}>
              {ADOPT.email[lang]}
            </label>
            <input
              class="field-input"
              id="email"
              name="email"
              type="email"
              value={values.email}
              autocomplete="email"
              required
            />
            {errors.email && (
              <div class="field-error" {...bi(ADOPT_ERRORS.email, lang)}>
                {ADOPT_ERRORS.email[lang]}
              </div>
            )}
          </div>

          <div>
            <label class="field-label" for="phone">
              <span {...bi(ADOPT.phone, lang)}>{ADOPT.phone[lang]}</span>{' '}
              <span class="field-note" {...bi(COMMON.optional, lang)}>
                · {COMMON.optional[lang]}
              </span>
            </label>
            <input
              class="field-input"
              id="phone"
              name="phone"
              type="tel"
              value={values.phone}
              autocomplete="tel"
            />
            {errors.phone && (
              <div class="field-error" {...bi(ADOPT_ERRORS.phone, lang)}>
                {ADOPT_ERRORS.phone[lang]}
              </div>
            )}
          </div>

          {/* The privacy sentence, with no link. When there IS a policy, the
              link goes here and nowhere else — one obvious place, left on
              purpose (design-record.md, answered open question 1). */}
          <p class="privacy" {...bi(ADOPT.privacy, lang)}>{ADOPT.privacy[lang]}</p>

          <div class="spacer" />
          <button class="btn btn-tall btn-action" type="submit" {...bi(ADOPT.submit, lang)}>
            {ADOPT.submit[lang]}
          </button>
        </form>
      )
    }
  </div>
</Screen>

<style>
  .adopt-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-height: 0;
  }
  .field-help { font-size: 13px; margin-top: 6px; }
  .privacy {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--theme-muted);
  }
</style>
