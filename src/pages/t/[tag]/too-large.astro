---
// Where a refused upload lands. The one screen in this build with no
// counterpart in the approved screens, and it exists for a reason the approved
// screens make load-bearing: telling us a bed needs care is the core street
// action, so an OPTIONAL attachment must never cost somebody what they already
// told us. The category they picked and the sentence they typed are carried
// here, and one tap sends them without the photo.
//
// Three refusals, one screen, three sets of words: a photo to shrink, a queue
// to retry, and an upload that stopped halfway ask different things from the
// person holding the phone — and telling someone their photo was too large
// when it never all arrived sends them off to fix something that was fine.
//
// Plain forms and links only, like the screens it sits between.
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { getBedView } from '../../../lib/service';
import { bi } from '../../../lib/bilingual';
import { TOO_LARGE } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor, themeVar } from '../../../lib/presentation';
import { noteFrom, problemFor, problemFrom } from '../../../lib/problem';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseWithBody, requireBoundTagForView } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForView(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
if (!view) {
  return await refuseWithBody(Astro.request, new Response('No bed with that plate.', { status: 404 }));
}

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);

// Null when the upload was refused before the category arrived — then the only
// honest offer is the picker again, not a category we guessed.
const category = problemFrom(Astro.url.searchParams.get('category'));
const picked = category === null ? null : problemFor(category);
const note = noteFrom(Astro.url.searchParams.get('note'));

const reasonParam = Astro.url.searchParams.get('reason');
const reason = reasonParam === 'busy' || reasonParam === 'incomplete' ? reasonParam : 'over-limit';
const COPY = {
  'over-limit': {
    tab: TOO_LARGE.tabOverLimit,
    title: TOO_LARGE.titleOverLimit,
    body: TOO_LARGE.bodyOverLimit,
    action: TOO_LARGE.sendWithout,
  },
  busy: {
    tab: TOO_LARGE.tabBusy,
    title: TOO_LARGE.titleBusy,
    body: TOO_LARGE.bodyBusy,
    action: TOO_LARGE.sendAgain,
  },
  incomplete: {
    tab: TOO_LARGE.tabIncomplete,
    title: TOO_LARGE.titleIncomplete,
    body: TOO_LARGE.bodyIncomplete,
    action: TOO_LARGE.sendWithout,
  },
} as const;
const copy = COPY[reason];
---

<Screen title={copy.tab[lang]} lang={lang} presentation={presentation} url={Astro.url}>
  <div class="screen">
    <div class="kicker">{presentation.copy.wordmark}</div>
    <div class="card">
      <div class="title" {...bi(copy.title, lang)}>{copy.title[lang]}</div>
      <div class="ident standing" {...bi(TOO_LARGE.standing, lang)}>{TOO_LARGE.standing[lang]}</div>
    </div>
    <p class="body-copy" {...bi(copy.body, lang)}>{copy.body[lang]}</p>
    <div class="spacer" />
    {
      picked ? (
        <>
          <p class="body-copy">
            <span {...bi(TOO_LARGE.youPicked, lang)}>{TOO_LARGE.youPicked[lang]}</span>{' '}
            <strong class="picked" style={`color:${themeVar(picked.ink)}`} {...bi(picked.label, lang)}>
              {picked.label[lang]}
            </strong>
          </p>
          {note !== '' && <p class="body-copy note-echo">“{note}”</p>}
          {/* urlencoded, not multipart: there is no photo this time, and the
              route's text-only branch is what reads it. */}
          <form method="POST" action={langLink(`${base}/report`, lang)}>
            <input type="hidden" name="category" value={picked.value} />
            {note !== '' && <input type="hidden" name="note" value={note} />}
            <button class="btn btn-tall btn-alert" type="submit" {...bi(copy.action, lang)}>
              {copy.action[lang]}
            </button>
          </form>
        </>
      ) : (
        <a
          class="btn btn-tall btn-alert"
          href={langLink(`${base}/care`, lang)}
          {...bi(TOO_LARGE.pickAgain, lang)}
          >{TOO_LARGE.pickAgain[lang]}</a
        >
      )
    }
    <a class="btn-ghost" href={langLink(ourPlaqueLink(base), lang)} {...bi(TOO_LARGE.back, lang)}>
      {TOO_LARGE.back[lang]}
    </a>
  </div>
</Screen>

<style>
  .standing { margin-top: 12px; font-size: 11px; letter-spacing: 0.1em; line-height: 1.5; }
  .picked { font-weight: 700; }
  .note-echo { font-style: italic; margin-top: -6px; }
</style>
