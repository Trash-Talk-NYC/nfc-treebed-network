---
// The full-screen "Thank you", on the green ground.
//
// A takeover, per the captain (design-record.md, constraint 8): the ground
// reaches the edges of the viewport and behind the status bar, and there is
// nothing else on it. The final round settled what it carries — the block link
// is dropped.
//
// Animation is to follow and is deliberately NOT built. The seam for it is
// `.takeover-mark`: the headline and its sub sit inside one element that
// exists to be animated, so whoever adds the motion has something to target
// and nothing to restructure. `prefers-reduced-motion` is already honoured in
// global.css, so the first animation added inherits the guard.
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { getBedView } from '../../../lib/service';
import { bi } from '../../../lib/bilingual';
import { THANKS_TAKEOVER } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { COMMON } from '../../../lib/copy';
import { refuseMissingBedScreen, requireBoundTagForView } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForView(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
// The bed behind a bound tag can legitimately go away: a delete on the admin
// page retires it (service.ts). Every sub-page sends the visitor to the door
// screen for that, which is where the calm "not assigned to a bed yet" screen
// lives and which answers 404 itself.
if (!view) return await refuseMissingBedScreen(Astro.request, base);

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);

// Applause and a care report end on the same takeover with different words:
// one thanks somebody for telling us, the other tells them the stewards will
// hear it.
const applauded = Astro.url.searchParams.has('applause');
const big = applauded ? THANKS_TAKEOVER.applauded : THANKS_TAKEOVER.reported;
---

<Screen
  title={big[lang]}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
  takeover
>
  <div class="takeover-mark">
    <div class="big" {...bi(big, lang)}>{big[lang]}</div>
    {applauded && (
      <p class="sub takeover-sub applause-sub" {...bi(THANKS_TAKEOVER.applaudedSub, lang)}>
        {THANKS_TAKEOVER.applaudedSub[lang]}
      </p>
    )}
    {/*
      The mailing-list line went here and is deliberately absent: there is no
      real signup URL yet, and sending a neighbour to an address that does not
      exist is worse than a clean thank-you — the same reasoning the captain
      used to refuse a dead privacy-policy link. Putting it back needs one
      real URL on `Presentation.copy` in presentation.ts, rendered from the
      bed's record like everything else, plus its sentence in copy.ts.
    */}
  </div>
  <div class="takeover-actions">
    <a class="btn-ghost" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}>
      {COMMON.backToBed[lang]}
    </a>
  </div>
</Screen>

<style>
  /* The one element the animation will own. Nothing animates today. */
  .takeover-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .applause-sub { margin-bottom: -4px; }
</style>
