---
// "This bed needs care" — the problem picker, and the sentence box behind
// "something else".
//
// Two screens, one route, because they are one question asked twice:
//   default    the four quadrants + an optional photo + SEND IT
//   ?tell=1    the free-text box + an optional photo + SEND IT
//
// Both are plain HTML forms, and the picker is MULTI-select: the tiles are
// checkboxes, because a bed that is thirsty AND full of litter is one report,
// not a choice between the two. Picking "Something else" is a GET submit of
// the same form back to this route rather than a link, which is what carries
// the tiles already pressed onto the sentence screen with JavaScript disabled
// — a link's href cannot know what is checked, a GET form's query does. The
// sentence screen stays its own screen, as the approved screens show it, and
// sends the carried tiles back out as hidden fields beside `other`.
//
// The photo is attached on whichever screen the visitor sends from. Nothing
// stores it (spec §12): the report keeps only that one was attached, and the
// bytes are counted and dropped without ever being buffered (report.ts).
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { getBedView } from '../../../lib/service';
import { bi, biAttr } from '../../../lib/bilingual';
import { capitalizeFirst } from '../../../lib/format';
import { CARE, COMMON } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor, themeVar } from '../../../lib/presentation';
import { MAX_NOTE_CHARS, PROBLEMS, problemFor, problemsFrom } from '../../../lib/problem';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseMissingBedScreen, requireBoundTagForView } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForView(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
// The bed behind a bound tag can legitimately go away: a delete on the admin
// page retires it (service.ts). Every sub-page sends the visitor to the door
// screen for that, which is where the calm "not assigned to a bed yet" screen
// lives and which answers 404 itself.
if (!view) return await refuseMissingBedScreen(Astro.request, base);

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);
const bed = view.bed;

// The sentence screen. `tell` rather than `category=other` so the URL says
// what the screen is rather than what it will submit.
const telling = Astro.url.searchParams.has('tell');
// Set when SEND IT arrived with no tile chosen. The tiles are checkboxes, which
// no browser can hold to "at least one" the way a radio's `required` held one
// tile — so the server is the rule, and it says so here.
const nothingPicked = Astro.url.searchParams.has('pick');

const tiles = PROBLEMS.filter((p) => !p.wantsNote);
const other = PROBLEMS.find((p) => p.wantsNote)!;

// Tiles named on the URL: what "Something else"'s GET submit carried onto the
// sentence screen, and what the back links and the too-large screen's "pick
// it again" hand back so nobody re-presses what they already pressed.
const named = problemsFrom(Astro.url.searchParams.getAll('category'));
// Picker screen: these arrive pressed.
const checked = new Set(named);
// Sentence screen: these ride along as hidden fields beside `other`, and the
// visitor is shown what they are sending (`carriedProblems`).
const carried = named.filter((value) => value !== other.value);
const carriedProblems = carried.map(problemFor);
const carriedQuery = carried.map((value) => `category=${value}`).join('&');

const action = langLink(`${base}/report`, lang);
const backToBed = langLink(ourPlaqueLink(base), lang);
const backToChoices = langLink(`${base}/care${carriedQuery ? `?${carriedQuery}` : ''}`, lang);
---

<Screen
  title={`${(telling ? CARE.noteTitle : CARE.title)[lang]} · ${capitalizeFirst(bed.treeType[lang])}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <a
    class="back-link"
    href={telling ? backToChoices : backToBed}
    {...bi(telling ? COMMON.backToChoices : COMMON.backToBed, lang)}
    >{(telling ? COMMON.backToChoices : COMMON.backToBed)[lang]}</a
  >
  <h1 class="title" {...bi(telling ? CARE.noteTitle : CARE.title, lang)}>
    {(telling ? CARE.noteTitle : CARE.title)[lang]}
  </h1>

  {/* multipart, and the text parts first: the route reads the category and
      the note off the head of the body and never buffers the photo, which
      only works while the file input is last in the DOM (request-body.ts).
      `tests/care-form-order.e2e.test.ts` posts this form in its rendered
      order, so moving the file input up fails the suite. */}
  <form class="care-form" method="POST" action={action} enctype="multipart/form-data">
    {/* The form's DEFAULT button, deliberately first and carrying nothing:
        Enter after checking a tile files the report. Without it the first
        submit in tree order is "Something else", whose GET would carry a
        visitor to the sentence screen at the moment they meant to send. */}
    <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
    {
      telling ? (
        <>
          <input type="hidden" name="category" value={other.value} />
          {carried.map((value) => (
            <input type="hidden" name="category" value={value} />
          ))}
          <p class="body-copy" {...bi(CARE.noteHelp, lang)}>
            {CARE.noteHelp[lang]}
          </p>
          <textarea
            class="freetext"
            name="note"
            rows="5"
            maxlength={MAX_NOTE_CHARS}
            {...biAttr('placeholder', CARE.notePlaceholder, lang)}
          />
          <div class="charcount" data-charcount>0 / {MAX_NOTE_CHARS}</div>
          {carriedProblems.length > 0 && (
            <p class="also-sending">
              <span {...bi(CARE.alsoSending, lang)}>{CARE.alsoSending[lang]}</span>{' '}
              {carriedProblems.map((problem, i) => (
                <Fragment>
                  {i > 0 && <span class="also-sep">·</span>}
                  <span
                    class="also-cat"
                    style={`color:${themeVar(problem.ink)}`}
                    {...bi(problem.label, lang)}
                  >
                    {problem.label[lang]}
                  </span>
                </Fragment>
              ))}
            </p>
          )}
        </>
      ) : (
        <>
          {nothingPicked && (
            <p class="field-error" {...bi(CARE.pickOne, lang)}>
              {CARE.pickOne[lang]}
            </p>
          )}
          {/* What carries the language through the GET submit below: a GET
              replaces its action's query string, so `?lang=` on the action
              would be lost — the field rides instead, and the layout's
              toggle script keeps its value current. Harmless on the POST,
              whose action still carries the language. */}
          <input type="hidden" name="lang" value={lang} />
          <div class="catgrid">
            {/* Checkbox + label: the whole tile is the hit target, every
                chosen state is `:checked`, and none of it needs script. The
                input is a direct child of the grid so the adjacent-sibling
                selector reaches its label; being absolutely positioned, it
                creates no track of its own. The ink is a theme role, never
                a hex. */}
            {tiles.map((problem) => (
              <Fragment>
                <input
                  class="quad-input"
                  type="checkbox"
                  id={`cat-${problem.value}`}
                  name="category"
                  value={problem.value}
                  checked={checked.has(problem.value)}
                />
                <label
                  class="quad"
                  for={`cat-${problem.value}`}
                  style={`color:${themeVar(problem.ink)};border-color:${themeVar(problem.edge)}`}
                >
                  <span {...bi(problem.label, lang)}>{problem.label[lang]}</span>
                </label>
              </Fragment>
            ))}
            {/* The fourth quadrant opens the sentence box — its own screen,
                as approved, with or without JavaScript. A GET submit of this
                same form rather than a link, so the tiles already pressed
                ride its query string onto that screen. */}
            <button
              class="quad quad-tell"
              type="submit"
              name="tell"
              value="1"
              formmethod="get"
              formaction={`${base}/care`}
              style={`color:${themeVar(other.ink)};border-color:${themeVar(other.edge)}`}
            >
              <span {...bi(other.label, lang)}>{other.label[lang]}</span>
            </button>
          </div>
        </>
      )
    }

    {/* The input is the pill's SIBLING, not its child, so the focus ring can
        be an adjacent-sibling rule like the tiles' rather than a `:has()`, and
        the pair sits in its own block so the hidden input's static position is
        beside the pill rather than at the form's corner — the same hazard
        `.catgrid` guards against for the tile checkboxes.
        Both label states are in the document and the class picks which shows;
        nothing rewrites text, so the language toggle keeps working on the one
        that is visible. */}
    <div class="photo-field">
      <input
        class="photo-input"
        id="photo"
        type="file"
        name="photo"
        accept="image/*"
        capture="environment"
      />
      <label class="photo-row" for="photo">
        <span class="photo-idle" {...bi(COMMON.addPhoto, lang)}>{COMMON.addPhoto[lang]}</span>
        <span class="photo-on" {...bi(COMMON.photoAttached, lang)}>{COMMON.photoAttached[lang]}</span>
      </label>
    </div>

    <div class="spacer" />
    <button class="btn btn-tall btn-on-clear" type="submit" {...bi(COMMON.sendIt, lang)}>
      {COMMON.sendIt[lang]}
    </button>
  </form>
</Screen>

<script is:inline>
  // Enhancement only, and only for the two things a plain form cannot say:
  // that a photo is now attached, and how much of the sentence is left. Both
  // screens submit correctly with this script absent — the file input is a
  // file input and the server caps the note either way.
  (function () {
    var photo = document.querySelector('.photo-input');
    var row = document.querySelector('.photo-row');
    if (photo && row) {
      photo.addEventListener('change', function () {
        row.classList.toggle('attached', !!(photo.files && photo.files.length > 0));
      });
    }
    var note = document.querySelector('.freetext');
    var count = document.querySelector('[data-charcount]');
    if (note && count) {
      var max = note.getAttribute('maxlength');
      var show = function () {
        count.textContent = note.value.length + ' / ' + max;
      };
      note.addEventListener('input', show);
      show();
    }
  })();
</script>

<style>
  .care-form {
    display: flex;
    flex-direction: column;
    gap: 13px;
    flex: 1;
    min-height: 0;
  }
  /* The sentence tile is a button, so it needs the label's own resets. */
  .quad-tell {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
  }
  .also-sending {
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-quiet);
    margin: -4px 0 0;
  }
  /* The tile inks are tuned for AA on the beige paper, not on the green
     ground, so each carried label sits on its own beige pill. */
  .also-sending .also-cat {
    font-weight: 700;
    background: var(--theme-ground);
    border-radius: 5px;
    padding: 1px 6px;
  }
  .also-sending .also-sep { color: var(--ink-quiet); padding: 0 2px; }
  .photo-on { display: none; }
  .photo-row.attached .photo-idle { display: none; }
  .photo-row.attached .photo-on { display: inline; }
  .charcount {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-quiet);
    text-align: right;
    margin-top: -6px;
  }
</style>
