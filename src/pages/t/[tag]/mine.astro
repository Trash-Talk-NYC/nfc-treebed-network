---
// The steward's own view of their bed — the same bed, different verbs.
// Streak and points render from stored values only; the earning rules are a
// later task.
//
// Not part of the visitor tap flow. It is the one place in the build with a
// "close the report" button, which is why `/clear` is gated on a signed-in
// steward of this bed (see clear.ts).
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { getBedView, hasPhotoThisWeek } from '../../../lib/service';
import { getSessionUserId } from '../../../lib/session';
import { relativeAge, sinceLabel } from '../../../lib/format';
import { bi } from '../../../lib/bilingual';
import { COMMON, MINE } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { problemFor } from '../../../lib/problem';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { publicHandle, publicInitials } from '../../../lib/types';
import { refuseWithBody, requireBoundTagForView } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForView(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
if (!view) {
  return await refuseWithBody(Astro.request, new Response('No bed with that plate.', { status: 404 }));
}

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);

const userId = getSessionUserId(Astro.cookies);
if (!userId) return Astro.redirect(langLink(`${base}/auth`, lang), 303);
const me = await store.getUser(userId);
if (!me) return Astro.redirect(langLink(`${base}/auth`, lang), 303);

const { bed, stewards, openSlots, openReport } = view;
const isSteward = stewards.some((s) => s.user.id === me.id);
// Signed in but not a steward of this bed → back to the public screen.
if (!isSteward) return Astro.redirect(langLink(ourPlaqueLink(base), lang), 303);

const photoLogged = await hasPhotoThisWeek(store, plate, me.id);
const openProblem = openReport ? problemFor(openReport.category) : null;
const openAge = openReport ? relativeAge(new Date(openReport.openedAt)) : null;

// What the neighbours who added their weight to the open report said. The
// report itself belongs to whoever filed it, so their category and their
// sentence live on the `confirm` events (service.ts, `reportProblem`) and this
// is where a steward reads them. Bounded by `MAX_CONFIRMATIONS`, so the list
// cannot run away.
const alsoSaid = openReport
  ? (await store.getEvents(plate, 'confirm'))
      .filter((e) => e.createdAt >= openReport.openedAt && (e.category !== null || e.note !== ''))
      .reverse()
      .map((e) => ({ problem: e.category ? problemFor(e.category) : null, note: e.note }))
  : [];

// Green "you sorted it" band: the most recent report was closed by me,
// recently enough to still be news (12h).
const lastReport = (await store.getReports(plate))[0] ?? null;
const clearedByMe =
  !openReport &&
  lastReport?.closedBy === me.id &&
  lastReport.closedAt !== null &&
  Date.now() - new Date(lastReport.closedAt).getTime() < 12 * 60 * 60 * 1000;
const clearedAge =
  clearedByMe && lastReport?.closedAt ? relativeAge(new Date(lastReport.closedAt)) : null;

// A steward who asked not to be shown publicly is still shown their own bed:
// the flag hides a name from the sidewalk, not a bed from the person tending
// it (types.ts, `Adoption.displayNameHidden`).
const visibleStewards = stewards.filter(
  ({ adoption, user }) => !adoption.displayNameHidden || user.id === me.id,
);
---

<Screen
  title={`${MINE.yourBed[lang]} · ${bed.treeType[lang]}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="screen">
    <div class="top-row">
      <a class="back-link" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}
        >{COMMON.backToBed[lang]}</a
      >
      <span class="kicker your-bed" {...bi(MINE.yourBed, lang)}>{MINE.yourBed[lang]}</span>
    </div>
    <div class="card">
      <h1 class="title" {...bi(bed.treeType, lang)}>{bed.treeType[lang]}</h1>
      <div class="ident bed-ident">
        {bed.plantingSpaceId && <>#{bed.plantingSpaceId} · </>}
        {bed.crossStreets}
      </div>
      <div class="stewards stewards-gap">
        {
          visibleStewards.map(({ adoption, user }) => {
            const since = sinceLabel(new Date(adoption.adoptedAt));
            return (
            <div class="steward">
              <span class="av">{publicInitials(user).replace(/[.\s]/g, '')}</span>
              <span class="who">
                <span class="handle">{publicHandle(user)}</span>
                <span class="initials">
                  {publicInitials(user)} ·{' '}
                  <span {...bi(since, lang)}>{since[lang]}</span>
                </span>
              </span>
            </div>
            );
          })
        }
        {openSlots > 0 && <div class="slot-open">{openSlots} / {bed.slots}</div>}
      </div>
    </div>
    {
      openReport && openProblem && openAge && (
        <div class="band band-alert">
          <div class="band-title" {...bi(MINE.openReport, lang)}>
            {MINE.openReport[lang]}
          </div>
          <div class="band-sub">
            <span {...bi(openProblem.label, lang)}>{openProblem.label[lang]}</span> ·{' '}
            <span {...bi(openAge, lang)}>{openAge[lang]}</span>
          </div>
        </div>
      )
    }
    {openReport?.note && <p class="body-copy note-echo">“{openReport.note}”</p>}
    {
      alsoSaid.length > 0 && (
        <ul class="also-said">
          {alsoSaid.map(({ problem, note }) => (
            <li>
              {problem && (
                <span class="also-label" {...bi(problem.label, lang)}>
                  {problem.label[lang]}
                </span>
              )}
              {note && <span class="also-note">“{note}”</span>}
            </li>
          ))}
        </ul>
      )
    }
    {
      clearedByMe && clearedAge && (
        <div class="band band-clear">
          <div class="band-title" {...bi(MINE.cleared, lang)}>
            {MINE.cleared[lang]}
          </div>
          <div class="band-sub" {...bi(clearedAge, lang)}>
            {clearedAge[lang]}
          </div>
        </div>
      )
    }
    <div class="stats">
      <span>
        <span class="stat">{me.streakWeeks}</span>{' '}
        <span {...bi(MINE.streak, lang)}>{MINE.streak[lang]}</span>
      </span>
      <span>
        <span class="stat">{me.points}</span>{' '}
        <span {...bi(MINE.points, lang)}>{MINE.points[lang]}</span>
      </span>
    </div>
    <div class="spacer" />
    {
      openReport && (
        <form method="POST" action={langLink(`${base}/clear`, lang)}>
          <button class="btn btn-outline" type="submit" {...bi(MINE.clearIt, lang)}>
            {MINE.clearIt[lang]}
          </button>
        </form>
      )
    }
    <form method="POST" action={langLink(`${base}/photo`, lang)}>
      <button
        class="btn btn-tall btn-action"
        type="submit"
        {...bi(photoLogged ? MINE.photoIn : MINE.givePhoto, lang)}
        >{(photoLogged ? MINE.photoIn : MINE.givePhoto)[lang]}</button
      >
    </form>
  </div>
</Screen>

<style>
  .top-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .your-bed { padding-right: 52px; }
  .bed-ident { margin-top: 6px; }
  .stewards-gap { margin-top: 14px; }
  .note-echo { font-style: italic; }
  .also-said {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--theme-muted);
  }
  .also-said .also-label { font-weight: 600; color: var(--theme-ink); }
  .also-said .also-label + .also-note { margin-left: 6px; }
  .also-said .also-note { font-style: italic; }
  .stats {
    display: flex;
    justify-content: center;
    gap: 22px;
    font-size: 13px;
    font-weight: 500;
    color: var(--theme-muted);
    text-align: center;
  }
  .stats .stat { font-size: 17px; font-weight: 700; color: var(--theme-ink); }
  form + form { margin-top: -4px; }
</style>
