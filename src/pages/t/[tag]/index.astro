---
// The tap. Two doors.
//
// The URL carries an opaque tag ID and nothing else (map decision: no meaning
// in the tag URL; a tag's site is unknowable at encoding time). The ID resolves
// to a site server-side through tag-bindings.ts, and everything below the
// resolution is keyed by the site's plate — which is INTERNAL and is not
// rendered: what a visitor sees is NYC Parks' planting space ID.
//
// The bed's state picks the screen, server-side (design-record.md — the
// captain's Option B, closing a forty-round review):
//
//   unbound      a well-formed tag no binding speaks for. A normal state, not
//                an error: bulk-encoded tags sit in the wood before anyone
//                binds them. Calm screen, 404, no tap logged.
//   door 1       no steward yet → "This <tree>'s bed is looking for a steward."
//                → ADOPT THIS BED / THIS BED NEEDS CARE
//   door 2       already stewarded → "This <tree> bed has been adopted!", the
//                stewards shown → SEND APPLAUSE / THIS BED NEEDS CARE
//
// Either door withholds the adoption invitation while the bed has no offered
// slot (`openSlots`, which the admin page opens): door 1 says "isn't open for
// adoption yet" (DOOR_NOT_OFFERED) and offers care alone, door 2 drops "join
// them". That is a normal state, not a screen to fix — the six W 171st beds
// seed unoffered, so the tags on them open the not-yet-open door today.
//
// One clear question per screen. There is deliberately no third state for "a
// report is already open": a neighbour who taps a bed somebody else has just
// reported still gets door 2 and still presses THIS BED NEEDS CARE, and the
// rules add their weight to the open report rather than sending them to a
// screen about a rule (service.ts, `reportProblem`).
//
// The two doors stand on different GROUNDS, deliberately. Door 1 is Poster
// Beige — the page ground — and its headline carries no highlight, so it reads
// as one plain sentence; door 2 is Post No Bills Green with the tree type
// picked out in beige. The captain changed door 1 to beige after the review, so
// this asymmetry is the design, not an oversight to normalize: do not put
// `.hl` back on door 1 or move it back onto the green.
//
// Door 1's buttons had to change colour with the ground, because beige on
// beige is invisible. They take the page ground's own pair — Deep Purple for
// the adopt action, which is the palette's positive-ownership role and what
// the adopt form's own submit already uses, and the Roadtop Black outline for
// the secondary. Both clear WCAG AA on beige (7.63:1 and 16.04:1), and no
// yellow appears on that screen at all, so the one pairing that cannot work on
// this ground never arises. `tests/presentation.test.ts` holds every pair.
//
// Option A — the plaque-first screen this replaced — is scrapped, not flagged
// off. Do not restore it.
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { engravedStewards, getBedView, logTap } from '../../../lib/service';
import { getActorId } from '../../../lib/session';
import { isPostAction } from '../../../lib/plaque-url';
import { resolveTagParam } from '../../../lib/tag-bindings';
import { abandonBody } from '../../../lib/request-body';
import { bi } from '../../../lib/bilingual';
import { capitalizeFirst } from '../../../lib/format';
import { ABOUT, COMMON, DOOR_NOT_OFFERED, DOOR_STEWARDED, DOOR_UNSTEWARDED, UNBOUND } from '../../../lib/copy';
import { langLink, resolveLang } from '../../../lib/i18n';
import { defaultPresentation, presentationFor } from '../../../lib/presentation';
import { publicHandle, publicInitials } from '../../../lib/types';

// Astro renders this for any method, so a hand-built POST lands here like a
// tap does — and a body answered without being touched is one Node dumps to
// its end for us. Nothing on this screen reads one, so it is stopped here,
// before the render: a GET has no body and this costs it nothing.
await abandonBody(Astro.request);

const url = Astro.url;
const resolved = resolveTagParam(Astro.params.tag);
if (resolved.state === 'invalid') {
  return new Response('Not a tag on this network.', { status: 404 });
}
// One canonical URL per tag: a mistyped or hand-decorated ID (case, hyphens,
// lookalikes) lands here, then reads and shares as the address the chip
// carries. The query string rides along — it may hold our own post-action
// flag, the language, a decorator's UTM tags, or (later) an NTAG424's
// parameters.
if (Astro.params.tag !== resolved.tag) {
  // 303 for anything that arrived with a body, as every other redirect that can
  // answer a POST does: a 302 invites a client reading RFC 9110 to repeat the
  // POST at the canonical plaque, which is the one screen that logs a tap.
  const seeOther = Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD';
  return Astro.redirect(`/t/${resolved.tag}${url.search}`, seeOther ? 303 : 302);
}

const lang = resolveLang(url, Astro.cookies);
const tag = resolved.tag;
const base = `/t/${tag}`;

const store = getStore();
const view = resolved.state === 'bound' ? await getBedView(store, resolved.plate) : null;
if (resolved.state === 'bound' && view === null) {
  // Two ways a bound tag can have no bed behind it, and only one is ours to
  // say on stderr. A bed deleted on the admin page is RETIRED, not erased
  // (service.ts) — the row is still in the store, the tag legitimately shows
  // the calm screen, and a line per tap would let a tag we chose to retire
  // write the log. A plate the store has never heard of at all is a registry
  // typo, and that one is our mistake.
  if ((await store.getBed(resolved.plate)) === null) {
    console.error(`[plaque] tag ${tag} is bound to unknown site ${resolved.plate}`);
  }
}

// Unbound: still 404. There is no site here for a crawler or a monitor to
// believe in, and no tap is logged — sites own history, and this tag has none
// to write to.
if (view === null) Astro.response.status = 404;

const actor = view === null ? null : getActorId(Astro.cookies);

// A tap is a person opening the URL on the chip: a GET, never a hand-built
// POST or a monitor's HEAD, and never one of our own navigations back here
// (plaque-url.ts). The language toggle rides the same rule for free — it is a
// link with `?lang=`, which is not one of the suppressing flags, so switching
// language on the plaque is a fresh render but not a fresh tap only because
// `isPostAction` also sees `tg_action` on every link of ours. On the plaque
// itself the toggle re-renders the same URL, so it does count a second view;
// that is one visitor at one tree either way, and the alternative — treating
// `lang` as a suppressing flag — would let any decorated URL carrying `lang`
// silently stop counting.
const tapShaped = Astro.request.method === 'GET';
if (view !== null && actor !== null && tapShaped && !isPostAction(url)) {
  try {
    await logTap(store, { plate: view.bed.plate, actorId: actor });
  } catch (err) {
    // Telemetry fails open: a lost tap event must never cost a passer-by the
    // screen, which every read below can still render.
    console.error(`[plaque] tap not recorded for ${view.bed.plate}:`, err);
  }
}

const presentation = view ? presentationFor(view.bed) : defaultPresentation();
const bed = view?.bed ?? null;
const stewards = view?.stewards ?? [];
const openSlots = view?.openSlots ?? 0;
// Stewarded is the adoption count, never how many rows render: a bed whose
// stewards have all asked not to be named is still taken, and falling through
// to door 1 would invite a stranger to adopt it.
const stewarded = stewards.length > 0;
// Door 1 says what the screen can actually do: the invitation only where a
// slot is offered, and the not-yet words where the captain has opened none.
const door1 = openSlots > 0 ? DOOR_UNSTEWARDED : DOOR_NOT_OFFERED;
const engraved = engravedStewards(stewards);

const care = langLink(`${base}/care`, lang);
const adopt = langLink(`${base}/adopt`, lang);
const about = langLink(`${base}/about`, lang);

const title = bed
  ? `${capitalizeFirst(bed.treeType[lang])} · ${presentation.copy.wordmark}`
  : `${presentation.copy.wordmark}`;
---

<Screen
  title={title}
  lang={lang}
  presentation={presentation}
  url={url}
  ground={stewarded ? 'clear' : 'page'}
>
  {
    view === null && (
      <div class="screen">
        <div class="kicker">{presentation.copy.wordmark}</div>
        <div class="card">
          <div class="title" {...bi(UNBOUND.title, lang)}>
            {UNBOUND.title[lang]}
          </div>
          <div class="ident unbound-id">
            <span {...bi(UNBOUND.tagLabel, lang)}>{UNBOUND.tagLabel[lang]}</span> {tag}
          </div>
        </div>
        <div class="body-copy" {...bi(UNBOUND.body, lang)}>
          {UNBOUND.body[lang]}
        </div>
        <div class="spacer" />
      </div>
    )
  }

  {
    bed && !stewarded && (
      <div class="screen">
        {/* Poster Beige, and no highlight — see the header. */}
        <div>
          <div class="kicker">
            {presentation.copy.wordmark}
            {presentation.copy.locality && ` · ${presentation.copy.locality}`}
          </div>
          {bed.plantingSpaceId && <div class="ident">#{bed.plantingSpaceId}</div>}
          {/* The bed's given name, which outlives the steward who gave it —
              a named bed whose steward left still renders it here. Its own
              leaf, as typed, in BOTH languages: a name is not translated and
              is never spliced into the bilingual headline. No element at all
              on an unnamed bed. */}
          {bed.bedName !== null && <div class="bed-name">“{bed.bedName}”</div>}
        </div>
        <div class="mid">
          {/* Split into leaves either side of the tree type: the swap sets
              textContent, so a bilingual node may not have children. */}
          <h1 class="hero">
            <span {...bi(door1.headBefore, lang)}>{door1.headBefore[lang]}</span>
            <span {...bi(bed.treeType, lang)}>{bed.treeType[lang]}</span>
            <span {...bi(door1.headAfter, lang)}>{door1.headAfter[lang]}</span>
          </h1>
          <p class="body-copy door-sub" {...bi(door1.sub, lang)}>
            {door1.sub[lang]}
          </p>
        </div>
        {openSlots > 0 && (
          <a class="btn btn-tall btn-action" href={adopt} {...bi(DOOR_UNSTEWARDED.adopt, lang)}>
            {DOOR_UNSTEWARDED.adopt[lang]}
          </a>
        )}
        <a class="btn btn-outline" href={care} {...bi(COMMON.needsCare, lang)}>
          {COMMON.needsCare[lang]}
        </a>
        {/* A small text link, deliberately not a third big button: the door
            keeps one clear question, and the profile is a read, not an act. */}
        <a class="btn-ghost" href={about} {...bi(ABOUT.fromDoor, lang)}>
          {ABOUT.fromDoor[lang]}
        </a>
      </div>
    )
  }

  {
    bed && stewarded && (
      <div class="screen screen-clear">
        <div>
          <div class="kicker">
            {presentation.copy.wordmark}
            {presentation.copy.locality && ` · ${presentation.copy.locality}`}
          </div>
          {bed.plantingSpaceId && <div class="ident">#{bed.plantingSpaceId}</div>}
          {/* Same leaf as door 1: the plaque line a first steward engraved. */}
          {bed.bedName !== null && <div class="bed-name">“{bed.bedName}”</div>}
        </div>
        <h1 class="title adopted-head">
          <span {...bi(DOOR_STEWARDED.headBefore, lang)}>{DOOR_STEWARDED.headBefore[lang]}</span>
          <span class="hl" {...bi(bed.treeType, lang)}>{bed.treeType[lang]}</span>
          <span {...bi(DOOR_STEWARDED.headAfter, lang)}>{DOOR_STEWARDED.headAfter[lang]}</span>
        </h1>
        {/* No box at all when every steward has asked not to be named: an
            empty panel under its heading would read as a bug. The screen still
            says the bed is adopted, and still offers both actions. */}
        {engraved.length > 0 && (
          <div class="box">
            <div class="panel-h" {...bi(COMMON.stewards, lang)}>
              {COMMON.stewards[lang]}
            </div>
            <div class="stewards stewards-gap">
              {/* Username first, then initials. Full name, email and phone are
                  admin-only and never reach a public screen. */}
              {engraved.map(({ user }) => (
                <div class="steward">
                  <span class="av">{publicInitials(user).replace(/[.\s]/g, '')}</span>
                  <span class="who">
                    <span class="handle">{publicHandle(user)}</span>
                    <span class="initials">{publicInitials(user)}</span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="spacer" />
        {/* A plain form POST, like everything else here: applause works with
            JavaScript disabled. */}
        <form method="POST" action={langLink(`${base}/applause`, lang)}>
          <button class="btn btn-tall btn-on-clear" type="submit" {...bi(DOOR_STEWARDED.applaud, lang)}>
            {DOOR_STEWARDED.applaud[lang]}
          </button>
        </form>
        <a class="btn btn-on-clear-outline" href={care} {...bi(COMMON.needsCare, lang)}>
          {COMMON.needsCare[lang]}
        </a>
        {openSlots > 0 && (
          <a class="btn-ghost" href={adopt} {...bi(DOOR_STEWARDED.joinThem, lang)}>
            {DOOR_STEWARDED.joinThem[lang]}
          </a>
        )}
        {/* Same small link as door 1 — never a third big button. */}
        <a class="btn-ghost" href={about} {...bi(ABOUT.fromDoor, lang)}>
          {ABOUT.fromDoor[lang]}
        </a>
      </div>
    )
  }
</Screen>

<style>
  .unbound-id { margin-top: 10px; }
  .door-sub { margin-top: 14px; }
  /* The engraved name: plaque type, sized under the headline it sits above.
     Inherits each door's ink, so it holds AA on both grounds the way every
     other inherited line does. */
  .bed-name {
    font-family: 'Londrina Solid', cursive;
    font-weight: 400;
    font-size: 20px;
    overflow-wrap: anywhere;
    margin-top: 6px;
  }
  /* The stewards box sits directly under the headline on door 2, which is a
     shorter statement than door 1's — so the block is not optically centred
     here, it is stacked and the actions take the bottom. */
  .adopted-head { font-size: clamp(28px, 8vw, 34px); }
  .stewards-gap { margin-top: 11px; }
  /* Two full-width actions on the green ground, tight to each other so they
     read as one pair rather than two decisions. */
  .screen-clear form + .btn { margin-top: -4px; }
</style>
