---
// Sign in — username + PIN. The PIN never appears in any response or log;
// verification happens server-side against the bcrypt hash only.
//
// Not part of the tap flow the captain reviewed: nothing on either door links
// here. It is how a steward who already put their name on a bed gets back to
// it, and it is kept in the identity and both languages like everything else.
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import { RuleError, getBedView, signIn } from '../../../lib/service';
import { getSessionUserId, setSessionUser } from '../../../lib/session';
import { MAX_FORM_BYTES, readFormOrRefuse } from '../../../lib/request-body';
import { bi } from '../../../lib/bilingual';
import { AUTH, COMMON } from '../../../lib/copy';
import { langLink, resolveLang, type Phrase } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseMissingBedScreen, requireBoundTagForForm } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForForm(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
// The bed behind a bound tag can legitimately go away: a delete on the admin
// page retires it (service.ts). Every sub-page sends the visitor to the door
// screen for that, which is where the calm "not assigned to a bed yet" screen
// lives and which answers 404 itself.
if (!view) return await refuseMissingBedScreen(Astro.request, base);

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);

// Already signed in → straight to the steward's view.
if (Astro.request.method === 'GET' && getSessionUserId(Astro.cookies)) {
  return Astro.redirect(langLink(`${base}/mine`, lang), 303);
}

let error: Phrase | null = null;
let username = '';
if (Astro.request.method === 'POST') {
  // Public and unauthenticated, like every POST here: two short text fields
  // never need more, and an unbounded body is free memory exhaustion.
  const { form, refused } = await readFormOrRefuse(Astro.request, MAX_FORM_BYTES, 'sign-in');
  // Each reason gets its own answer: a 413 would send somebody off to shorten
  // a sign-in that was never long.
  if (refused) return refused;
  username = String(form.get('username') ?? '');
  const pin = String(form.get('pin') ?? '');
  try {
    const user = await signIn(store, { username, pin });
    setSessionUser(Astro.cookies, user.id);
    return Astro.redirect(langLink(`${base}/mine`, lang), 303);
  } catch (err) {
    if (err instanceof RuleError && err.code === 'invalid-credentials') {
      // Deliberately the same answer for an unknown handle and a wrong PIN —
      // the constant-time compare in `signIn` is only worth anything if the
      // screen says the same thing either way.
      error = AUTH.bad;
    } else if (err instanceof RuleError && err.code === 'busy') {
      // Shed because too many PIN hashes are already running. Same screen with
      // the username still in it, not a bare 503: this is a retry, and the
      // visitor should have to retype nothing but the PIN — which this form
      // never re-fills anyway.
      error = AUTH.busy;
      Astro.response.status = 503;
      Astro.response.headers.set('retry-after', '5');
    } else {
      throw err;
    }
  }
}
---

<Screen
  title={`${AUTH.title[lang]} · ${presentation.copy.wordmark}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="screen">
    <a class="back-link" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}
      >{COMMON.backToBed[lang]}</a
    >
    <h1 class="title" {...bi(AUTH.title, lang)}>{AUTH.title[lang]}</h1>
    <p class="body-copy" {...bi(AUTH.sub, lang)}>{AUTH.sub[lang]}</p>
    <form method="POST" action={langLink(`${base}/auth`, lang)} class="auth-form">
      <div>
        <label class="field-label" for="username" {...bi(AUTH.username, lang)}>
          {AUTH.username[lang]}
        </label>
        <input
          class="field-input"
          id="username"
          name="username"
          type="text"
          placeholder="@"
          value={username}
          autocomplete="username"
          autocapitalize="none"
          required
        />
      </div>
      <div>
        <label class="field-label" for="pin" {...bi(AUTH.pin, lang)}>{AUTH.pin[lang]}</label>
        <input
          class="field-input"
          id="pin"
          name="pin"
          type="password"
          inputmode="numeric"
          autocomplete="current-password"
          required
        />
      </div>
      {error && <div class="field-error" {...bi(error, lang)}>{error[lang]}</div>}
      <div class="spacer" />
      <button class="btn btn-tall btn-action" type="submit" {...bi(AUTH.submit, lang)}>
        {AUTH.submit[lang]}
      </button>
    </form>
  </div>
</Screen>

<style>
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-height: 0;
  }
</style>
