---
// Sign in — passwordless, by emailed link (the captain's standing decision,
// adopt-name-split-r5): enter the email you adopted with, get a single-use
// link that works for minutes. No secret is invented, stored, or emailed —
// the store holds only a hash of the token (service.ts), and this screen
// never logs or echoes it.
//
// The answer is "check your inbox" whether or not the email is known:
// whether an address adopted here is not a public question. What still
// differs between the two is the time the mail call takes for a real
// steward — a residual timing signal, accepted and noted here rather than
// padded over, the same tier as the per-IP limiting recorded as owed in
// request-body.ts. The rate limit (per email and per bed, in the store) is
// what keeps the probe from being free either way.
//
// Not part of the tap flow the captain reviewed: nothing on either door
// links here. It is how a steward who cleared cookies gets back to their
// bed, in both languages and with no script, like everything else.
import Screen from '../../../layouts/Screen.astro';
import { getStore } from '../../../lib/store';
import {
  MAX_EMAIL_CHARS,
  RuleError,
  getBedView,
  isValidEmail,
  requestSignInLink,
} from '../../../lib/service';
import { getSessionUserId } from '../../../lib/session';
import { mailAvailable, publicOrigin, sendMail } from '../../../lib/mail';
import { buildSignInMail } from '../../../lib/signin-mail';
import { MAX_FORM_BYTES, readFormOrRefuse } from '../../../lib/request-body';
import { bi } from '../../../lib/bilingual';
import { AUTH, COMMON } from '../../../lib/copy';
import { langLink, resolveLang, type Phrase } from '../../../lib/i18n';
import { presentationFor } from '../../../lib/presentation';
import { ourPlaqueLink } from '../../../lib/plaque-url';
import { refuseMissingBedScreen, requireBoundTagForForm } from '../../../lib/tag-route';

const { bound, refused: notBound } = await requireBoundTagForForm(Astro.params.tag, Astro.request);
if (notBound) return notBound;
const { plate, base } = bound;
const store = getStore();
const view = await getBedView(store, plate);
// The bed behind a bound tag can legitimately go away: a delete on the admin
// page retires it (service.ts). Every sub-page sends the visitor to the door
// screen for that, which is where the calm "not assigned to a bed yet" screen
// lives and which answers 404 itself.
if (!view) return await refuseMissingBedScreen(Astro.request, base);

const lang = resolveLang(Astro.url, Astro.cookies);
const presentation = presentationFor(view.bed);

// Already signed in → straight to the steward's view.
if (Astro.request.method === 'GET' && getSessionUserId(Astro.cookies)) {
  return Astro.redirect(langLink(`${base}/mine`, lang), 303);
}

// The link needs an origin the recipient can trust: TREEBED_PUBLIC_ORIGIN in
// production (a Host-derived origin would let a caller mint a link for
// somebody else's email that points at a host of their choosing), and the
// request's own origin as the dev/e2e convenience. No origin, or no mail
// transport, both mean the same honest screen: email sign-in isn't ready.
const origin = publicOrigin(Astro.url.origin);
const available = mailAvailable() && origin !== null;

let error: Phrase | null = null;
let email = '';
// `?sent=1` is the post-redirect "check your inbox" state — an unknown query
// param everywhere else, per the tag-URL rules, and harmless typed by hand:
// it reveals nothing and requests nothing.
const sent = Astro.request.method === 'GET' && Astro.url.searchParams.get('sent') === '1';

if (Astro.request.method === 'POST') {
  // Public and unauthenticated, like every POST here: one short text field
  // never needs more, and an unbounded body is free memory exhaustion.
  const { form, refused } = await readFormOrRefuse(Astro.request, MAX_FORM_BYTES, 'sign-in');
  if (refused) return refused;
  email = String(form.get('email') ?? '').slice(0, MAX_EMAIL_CHARS);
  if (!available) {
    error = AUTH.unavailable;
    Astro.response.status = 503;
  } else if (!isValidEmail(email)) {
    // A shape check only, answered the same for every address: this is about
    // not spending a rate-limit slot on a typo, not about which emails exist.
    error = AUTH.emailInvalid;
    Astro.response.status = 422;
  } else {
    try {
      const outcome = await requestSignInLink(store, { plate, email });
      if (outcome.kind === 'sent') {
        // The token's only journey: into this link, into the mail. The URL
        // itself is built with URLSearchParams so the token is carried
        // verbatim, and `origin` is the trusted one resolved above.
        const params = new URLSearchParams({ token: outcome.token });
        const link = `${origin}${langLink(`${base}/signin?${params.toString()}`, lang)}`;
        const delivery = await sendMail(buildSignInMail({ email: outcome.user.email, lang, link }));
        if (!delivery.ok) {
          // The token row stays; the visitor retries and gets a fresh one.
          // The failure detail goes to the log (mail.ts already kept the
          // message out of it), the visitor gets words they can act on.
          console.error(`[auth] sign-in mail failed: ${delivery.detail}`);
          error = AUTH.sendFailed;
          Astro.response.status = 503;
          Astro.response.headers.set('retry-after', '10');
        }
      }
      if (!error) {
        // One redirect for a known and an unknown address alike.
        return Astro.redirect(langLink(`${base}/auth?sent=1`, lang), 303);
      }
    } catch (err) {
      if (err instanceof RuleError && err.code === 'rate-limited') {
        // Decided by the hashed ledger alone (service.ts), so this answer is
        // identical whether or not the email is anybody's.
        error = AUTH.rateLimited;
        Astro.response.status = 429;
        Astro.response.headers.set('retry-after', '600');
      } else {
        throw err;
      }
    }
  }
}
---

<Screen
  title={`${AUTH.title[lang]} · ${presentation.copy.wordmark}`}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <a class="back-link" href={langLink(ourPlaqueLink(base), lang)} {...bi(COMMON.backToBed, lang)}
    >{COMMON.backToBed[lang]}</a
  >
  {
    sent ? (
      <>
        <h1 class="title" {...bi(AUTH.sentTitle, lang)}>{AUTH.sentTitle[lang]}</h1>
        <p class="body-copy" {...bi(AUTH.sentBody, lang)}>{AUTH.sentBody[lang]}</p>
        <div class="spacer" />
        <a
          class="btn btn-on-clear"
          href={langLink(ourPlaqueLink(base), lang)}
          {...bi(COMMON.backToBed, lang)}
          >{COMMON.backToBed[lang]}</a
        >
      </>
    ) : !available ? (
      <>
        <h1 class="title" {...bi(AUTH.title, lang)}>{AUTH.title[lang]}</h1>
        <p class="body-copy" {...bi(AUTH.unavailable, lang)}>{AUTH.unavailable[lang]}</p>
        <div class="spacer" />
        <a
          class="btn btn-on-clear"
          href={langLink(ourPlaqueLink(base), lang)}
          {...bi(COMMON.backToBed, lang)}
          >{COMMON.backToBed[lang]}</a
        >
      </>
    ) : (
      <>
        <h1 class="title" {...bi(AUTH.title, lang)}>{AUTH.title[lang]}</h1>
        <p class="body-copy" {...bi(AUTH.sub, lang)}>{AUTH.sub[lang]}</p>
        <form method="POST" action={langLink(`${base}/auth`, lang)} class="auth-form">
          <div>
            <label class="field-label" for="email" {...bi(AUTH.email, lang)}>
              {AUTH.email[lang]}
            </label>
            <input
              class="field-input"
              id="email"
              name="email"
              type="email"
              maxlength={MAX_EMAIL_CHARS}
              value={email}
              autocomplete="email"
              required
            />
          </div>
          {error && <div class="field-error" {...bi(error, lang)}>{error[lang]}</div>}
          <div class="spacer" />
          <button class="btn btn-tall btn-on-clear" type="submit" {...bi(AUTH.submit, lang)}>
            {AUTH.submit[lang]}
          </button>
        </form>
      </>
    )
  }
</Screen>

<style>
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-height: 0;
  }
</style>
