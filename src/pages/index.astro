---
import Screen from '../layouts/Screen.astro';
import { bi } from '../lib/bilingual';
import { ROOT } from '../lib/copy';
import { resolveLang, type Lang } from '../lib/i18n';
import { ourPlaqueLink } from '../lib/plaque-url';
import { defaultPresentation } from '../lib/presentation';
import { abandonBody } from '../lib/request-body';
import { getActiveBed } from '../lib/service';
import { getStore } from '../lib/store';
import { demoBinding } from '../lib/tag-bindings';
import type { Bed } from '../lib/types';

// Rendered for any method, and an answer given without touching its body
// leaves Node to read that body to its end. Nothing here wants one.
await abandonBody(Astro.request);

// The root has no content of its own — a tag URL always names a tag, so
// strays go to the DEMO bed by name (`DEMO_TAG_ID`), never to whichever row
// happens to sit first: root traffic is monitors, crawlers and typed domains,
// and sending it to a real bed would inflate that bed's tap count.
//
// Flagged like every other navigation of ours: a tag never sends anyone here,
// so what does is an uptime check, a crawler, or somebody typing the domain —
// and a monitor polling this once a minute would be 1,440 taps a day on the
// bed it lands on.
//
// The redirect is conditional on the demo bed still being LIVE, because the
// admin can retire it like any other bed: following a binding whose bed is
// gone would land the root on the calm "not assigned" screen, which answers
// 404, and a pinned uptime check would start alerting on a delete nobody
// connected to the root. The bed is not made undeletable to prevent that —
// the root is made not to depend on it. Where there is nothing to redirect
// to, the screen below is a calm 200.
//
// The lookup is also the one place a store failure must not become a 500:
// root traffic is monitors and crawlers, and a backend that is down or
// misconfigured turning the uptime check red is the same alert-on-the-wrong-
// thing the conditional redirect exists to avoid. A store that cannot answer
// is simply nothing to redirect to.
const lang: Lang = resolveLang(Astro.url, Astro.cookies);
const demo = demoBinding();
let bed: Bed | null = null;
if (demo !== null) {
  try {
    bed = await getActiveBed(getStore(), demo.sitePlate);
  } catch (err) {
    console.error(`site root: the store could not be read, serving the calm screen — ${err}`);
  }
}
if (demo !== null && bed !== null) {
  const seeOther = Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD';
  return Astro.redirect(ourPlaqueLink(`/t/${demo.tagId}`), seeOther ? 303 : 302);
}

const presentation = defaultPresentation();
---

<Screen
  title={presentation.copy.wordmark}
  lang={lang}
  presentation={presentation}
  url={Astro.url}
>
  <div class="kicker">{presentation.copy.wordmark}</div>
  <div class="card">
    <div class="title" {...bi(ROOT.title, lang)}>{ROOT.title[lang]}</div>
  </div>
  <div class="body-copy" {...bi(ROOT.body, lang)}>{ROOT.body[lang]}</div>
  <div class="spacer"></div>
</Screen>
