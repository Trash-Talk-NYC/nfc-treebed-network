---
// The language control, on every screen including the takeovers.
//
// A two-state toggle, the captain's own word for it: both languages are shown
// and the one now speaking is visibly selected, rather than a single button
// printing the language it would switch to. Each segment is a plain link,
// deliberately — the captain asked for a control the visitor operates rather
// than a browser-language guess, and links are the version of that which
// works with JavaScript disabled: each carries `?lang=`, the server resolves
// it and sets the preference (i18n.ts). The inline script in the layout
// upgrades the same elements to an instant, no-reload swap.
//
// The segments name themselves in their own language — "EN" for the English
// reader, "ES" for the Spanish one — so each is legible to exactly the person
// who needs it, and neither ever changes with the page language. That is why
// they are literals here rather than Phrases in copy.ts.
import { biAttr } from '../lib/bilingual';
import { LANG_COPY } from '../lib/copy';
import { LANGUAGES, withLang, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  url: URL;
}
const { lang, url } = Astro.props;

const SEGMENT_LABELS: Record<Lang, { text: string; name: string }> = {
  en: { text: 'EN', name: 'English' },
  es: { text: 'ES', name: 'Español' },
};
---

<nav class="lang-toggle" {...biAttr('aria-label', LANG_COPY.toggleLabel, lang)}>
  {
    LANGUAGES.map((segment) => (
      <a
        class="lang-choice"
        data-lang-choice={segment}
        href={withLang(url, segment)}
        aria-label={SEGMENT_LABELS[segment].name}
        aria-current={segment === lang ? 'true' : undefined}
      >
        {SEGMENT_LABELS[segment].text}
      </a>
    ))
  }
</nav>

<style>
  /* Fixed rather than in flow: every screen below is a full-height column that
     ends in its primary action, and a control in the flow would either push
     that action down or land under the home indicator. Pinned top-right,
     clear of the notch on both sides — the inset is added to the offset, not
     substituted for it, so a device with no inset still gets real spacing. */
  .lang-toggle {
    position: fixed;
    top: calc(10px + env(safe-area-inset-top, 0px));
    /* Pinned to the RIGHT EDGE OF THE COLUMN, not of the viewport: the screens
       are authored at phone width and centred on anything wider, and a control
       stuck to the corner of a desktop window reads as belonging to the browser
       rather than to the page. Collapses to the screen edge on a phone, where
       the two are the same thing. */
    /* `100%` rather than `100vw`: a fixed element's percentage resolves
       against the viewport WITHOUT the scrollbar, while `100vw` includes it —
       so on a scrolling screen the vw version drifts half a scrollbar off the
       column it is supposed to be pinned to. */
    right: calc(max(0px, (100% - 430px) / 2) + 10px + env(safe-area-inset-right, 0px));
    z-index: 40;
    display: flex;
    border-radius: 22px;
    border: 2px solid var(--theme-border);
    background: var(--theme-surface);
    overflow: hidden;
  }
  .lang-choice {
    display: flex;
    align-items: center;
    justify-content: center;
    /* 44px is the smallest thing a thumb reliably hits — per segment. */
    min-width: 44px;
    min-height: 44px;
    padding: 0 6px;
    color: var(--theme-muted);
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .lang-choice:active {
    background: var(--theme-ground);
  }
  /* The language now speaking: filled, not ticked — selection legible at
     arm's length in the sun, the same standard the picker tiles are held to. */
  .lang-choice[aria-current='true'] {
    background: var(--theme-ink);
    color: var(--theme-surface);
  }

  /* On the coloured grounds — the two doors and the takeovers — it reads as
     part of the ground rather than a chip stuck on top of it. */
  :global(.ground-clear) .lang-toggle {
    border-color: var(--theme-on-clear-muted);
    background: transparent;
  }
  :global(.ground-clear) .lang-choice {
    color: var(--theme-on-clear-muted);
  }
  :global(.ground-clear) .lang-choice[aria-current='true'] {
    background: var(--theme-on-clear);
    color: var(--theme-clear);
  }
  :global(.ground-action) .lang-toggle {
    border-color: var(--theme-on-action);
    background: transparent;
  }
  :global(.ground-action) .lang-choice {
    color: var(--theme-on-action);
  }
  :global(.ground-action) .lang-choice[aria-current='true'] {
    background: var(--theme-on-action);
    color: var(--theme-action);
  }
</style>
