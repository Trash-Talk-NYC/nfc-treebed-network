---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {/* Empty data: icon stops browsers fetching /favicon.ico — that 404 cost
        4KB of error HTML on every cold tap. */}
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <div class="frame">
      <slot />
    </div>
  </body>
</html>
