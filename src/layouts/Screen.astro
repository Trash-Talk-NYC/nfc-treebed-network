---
// The shell every tap-flow screen renders inside.
//
// Three things live here because they are true of every screen and must not be
// re-decided per page:
//
//  1. SAFE AREAS. `viewport-fit=cover` is what makes `env(safe-area-inset-*)`
//     resolve to anything at all — without it the insets are zero and every
//     careful padding rule downstream is a no-op. This project has an expensive
//     history of header/safe-area bugs shipped from unverified theories, so the
//     one line that arms the whole mechanism sits here, next to the rules that
//     use it (`src/styles/global.css`, `.screen`), rather than in a page.
//  2. THE THEME. The bed's presentation is written once, as custom properties
//     on the root element (presentation.ts). Nothing downstream names a colour.
//  3. THE LANGUAGE. `<html lang>` is the active language, and the toggle is
//     rendered here so it is on every screen — including the full-screen
//     takeovers, which the captain named explicitly.
//  4. THE GROUND. Since the captain's 2026-09-11 reversal the whole tap flow
//     stands on solid Post No Bills Green with Poster Beige as the secondary,
//     so the role is named exactly once — here. The frame class, the screen
//     class and the browser chrome behind the notch all come off that one
//     name, because a screen whose body disagreed with its status bar is the
//     bug this used to be able to express. (The purple is a button role,
//     `.btn-action`, not a ground any screen stands on.)
import '../styles/global.css';
import LangToggle from '../components/LangToggle.astro';
import type { Lang } from '../lib/i18n';
import { themeStyle, type Presentation } from '../lib/presentation';

interface Props {
  title: string;
  lang: Lang;
  presentation: Presentation;
  /** The URL the toggle rewrites — always the screen's own. */
  url: URL;
  /**
   * A full-screen takeover ("Adopted!", "Thank you"): same ground, but the
   * centred statement exempts it from the toggle's gutter (global.css).
   */
  takeover?: boolean;
}

const { title, lang, presentation, url, takeover = false } = Astro.props;
const GROUND = 'clear';
const chrome = presentation.colors[GROUND];
---

<!doctype html>
<html lang={lang} style={themeStyle(presentation.colors)}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover: without it env(safe-area-inset-*) is 0 everywhere. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={chrome} />
    <meta name="robots" content="noindex" />
    {/* Empty data: icon stops browsers fetching /favicon.ico — that 404 cost
        4KB of error HTML on every cold tap. */}
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <div class={`frame ground-${GROUND}`}>
      <div class={`screen screen-${GROUND}${takeover ? ' takeover' : ''}`}>
        <slot />
      </div>
      <LangToggle lang={lang} url={url} />
    </div>
    <script is:inline>
      // The only client JavaScript in this layout, and the only thing it does
      // is make the language toggle instant. (The care screen ships the tap
      // flow's one other script, for the photo state and the note counter.)
      //
      // Every screen already carries both languages (src/lib/bilingual.ts) and
      // is already rendered in the right one by the server, so this enhances
      // and never enables: with it off, each segment is a link, the server
      // re-renders, and nothing on any screen is lost. That is the same
      // standard every form here is held to.
      (function () {
        var choices = document.querySelectorAll('[data-lang-choice]');
        if (choices.length === 0) return;
        var YEAR = 60 * 60 * 24 * 365;

        function apply(lang) {
          document.documentElement.lang = lang;
          document.querySelectorAll('[data-bi]').forEach(function (el) {
            var next = el.getAttribute('data-' + lang);
            if (next !== null) el.textContent = next;
            el.setAttribute('data-bi', lang);
          });
          // Bilingual attributes: placeholder, alt, aria-label, title.
          ['placeholder', 'alt', 'aria-label', 'title'].forEach(function (name) {
            document.querySelectorAll('[data-' + lang + '-' + name + ']').forEach(function (el) {
              el.setAttribute(name, el.getAttribute('data-' + lang + '-' + name));
            });
          });
          // Our own links and forms carry the language so a cookie-less
          // browser keeps it — a form left behind would post to the language
          // the server rendered and land the visitor on the wrong thank-you.
          [
            ['a[href]', 'href'],
            ['form[action]', 'action'],
          ].forEach(function (pair) {
            document.querySelectorAll(pair[0]).forEach(function (el) {
              var value = el.getAttribute(pair[1]);
              if (!value || value.indexOf('/') !== 0) return;
              // The bookmark cue prints its own address, so what it links to
              // has to stay that address — a language on it would make the
              // link a steward saves differ from the one they were shown.
              if (el.hasAttribute('data-bare')) return;
              var url = new URL(value, location.origin);
              if (lang === 'en') url.searchParams.delete('lang');
              else url.searchParams.set('lang', lang);
              el.setAttribute(pair[1], url.pathname + url.search + url.hash);
            });
          });
          // A GET submit replaces its action's query string, so the language
          // rides those forms as a hidden field instead (care.astro's
          // "Something else") — kept current here, after the generic pass.
          document.querySelectorAll('input[type=hidden][name=lang]').forEach(function (el) {
            el.value = lang;
          });
          // The toggle's own segments: mark the one now speaking, and point
          // each at the language it names on the URL we are now on — after
          // the generic pass above, which knows nothing of what they mean.
          choices.forEach(function (choice) {
            var to = choice.getAttribute('data-lang-choice');
            if (to === lang) choice.setAttribute('aria-current', 'true');
            else choice.removeAttribute('aria-current');
            var self = new URL(location.href);
            self.searchParams.set('lang', to);
            choice.setAttribute('href', self.pathname + self.search);
          });
          // A preference, not an identity — no signature, and it grants nothing.
          document.cookie = 'tg_lang=' + lang + ';path=/;max-age=' + YEAR + ';samesite=lax';
        }

        choices.forEach(function (choice) {
          choice.addEventListener('click', function (event) {
            event.preventDefault();
            var to = choice.getAttribute('data-lang-choice');
            if (to && document.documentElement.lang !== to) apply(to);
          });
        });
      })();
    </script>
  </body>
</html>
